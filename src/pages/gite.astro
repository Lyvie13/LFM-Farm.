---
import Navbar from "../components/navbar.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";
import "../styles/gite.css";

const titre = "Gîte équestre et locations de vacances | LFM Farm";

const images = {
  facade:
    "https://res.cloudinary.com/dhmehfgjo/image/upload/v1786696058/gite_face.jpg",
  prairie:
    "https://res.cloudinary.com/dhmehfgjo/image/upload/v1786704058/chevaux_prairie.jpg",
  mezenc:
    "https://res.cloudinary.com/dhmehfgjo/image/upload/v1786737208/volcans-auvergne-haute-loire-mezenc-2-1920x1080-f50_50_pkwcfl.jpg",
};

const photosInterieur = [
  "https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666676/cache_14598929_tklunj.jpg",
  "https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666668/cache_14598926_dqhegd.jpg",
  "https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666664/cache_14598925_tgscdb.png",
  "https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666652/cache_13717987_tekbfk.jpg",
  "https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666648/cache_13717986_rmszwr.jpg",
  "https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666639/cache_13717982_wqaozy.jpg",
  "https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666635/cache_13717981_qv8xa3.png",
  "https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666631/cache_13717980_vou29v.jpg",
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Découvrez le gîte équestre LFM Farm en Haute-Loire, au cœur de la campagne et à proximité du Mézenc."
    />
    <title>{titre}</title>
  </head>

  <body>
    <Navbar />

    <main>
      <section class="gite-hero">
        <img
          class="gite-hero-image"
          src={images.facade}
          alt="La maison du gîte LFM Farm"
        />
        <div class="gite-hero-overlay"></div>

        <div class="gite-labels" aria-label="Labels touristiques">
          <img
            class="gite-label-image"
            src="https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666684/h%C3%A9bergement_respirando.jpg"
            alt="Label Hébergement Respirando"
          />
          <img
            class="gite-label-image"
            src="https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666680/cheval_etape.jpg"
            alt="Label Cheval Étape"
          />
        </div>

        <div class="gite-hero-title">
          <h1>Gîte équestre et<br />locations de vacances</h1>
        </div>

        <div class="gite-hero-text">
          <p>
            Situé dans un charmant village de campagne,<br />
            entre rivières et montagnes surplombant la vallée de la Loire.
          </p>
          <p>
            Entouré de nos chevaux et sans aucun vis-à-vis,<br />
            le gîte est installé dans l’ancienne école du village, entièrement
            rénovée pour vous offrir tout le confort nécessaire à un séjour
            reposant et authentique.
          </p>
        </div>
      </section>

      <section class="gite-features">
        <div class="gite-features-grid">
          <article class="gite-feature gite-feature--intro">
            <div class="gite-icon" aria-hidden="true">
              <img src="/icons/ci--house-01.svg" alt="" />
            </div>
            <h2>Un hébergement chaleureux et tout confort</h2>
            <p>
              Le gîte a une capacité de 10 personnes, avec deux chambres de 4
              et un canapé-lit, deux WC ainsi que 2 salles de bain, une cuisine
              ouverte toute équipée et un coin salon.
            </p>
            <p>
              Pour rendre votre séjour aussi agréable que possible, vous
              bénéficiez également de nombreux équipements : lave-linge,
              lave-vaisselle, four, micro-ondes, bouilloire, appareil à raclette,
              appareil à fondue et crêpière.
            </p>
          </article>

          <div
            class="gite-interior-carousel"
            role="region"
            aria-label="Photos de l’intérieur du gîte"
            aria-roledescription="carrousel"
          >
            <div class="gite-interior-slides">
              {
                photosInterieur.map((photo, index) => (
                  <img
                    class:list={[
                      "gite-interior-slide",
                      { "is-active": index === 0 },
                    ]}
                    src={photo}
                    alt={`Intérieur du gîte LFM Farm - photo ${index + 1}`}
                    loading={index === 0 ? "eager" : "lazy"}
                    aria-hidden={index === 0 ? "false" : "true"}
                  />
                ))
              }
            </div>

            <button
              class="gite-carousel-expand"
              type="button"
              aria-label="Agrandir la photo"
            ></button>

            <button
              class="gite-carousel-arrow gite-carousel-arrow--previous"
              type="button"
              aria-label="Afficher la photo précédente"
            >
              <span aria-hidden="true"></span>
            </button>

            <button
              class="gite-carousel-arrow gite-carousel-arrow--next"
              type="button"
              aria-label="Afficher la photo suivante"
            >
              <span aria-hidden="true"></span>
            </button>

            <div class="gite-carousel-dots" aria-label="Choisir une photo">
              {
                photosInterieur.map((_, index) => (
                  <button
                    class:list={[
                      "gite-carousel-dot",
                      { "is-active": index === 0 },
                    ]}
                    type="button"
                    aria-label={`Afficher la photo ${index + 1}`}
                    aria-current={index === 0 ? "true" : "false"}
                    data-slide={index}
                  ></button>
                ))
              }
            </div>
          </div>

          <dialog class="gite-lightbox" aria-label="Photo agrandie de l’intérieur du gîte">
            <div class="gite-lightbox-content">
              <img
                class="gite-lightbox-image"
                src={photosInterieur[0]}
                alt="Intérieur du gîte LFM Farm"
              />

              <button
                class="gite-lightbox-close"
                type="button"
                aria-label="Fermer la photo agrandie"
              >
                <span aria-hidden="true">×</span>
              </button>

              <button
                class="gite-carousel-arrow gite-lightbox-arrow gite-lightbox-arrow--previous"
                type="button"
                aria-label="Afficher la photo précédente"
              >
                <span aria-hidden="true"></span>
              </button>

              <button
                class="gite-carousel-arrow gite-lightbox-arrow gite-lightbox-arrow--next"
                type="button"
                aria-label="Afficher la photo suivante"
              >
                <span aria-hidden="true"></span>
              </button>
            </div>
          </dialog>

          <img
            class="gite-feature-image"
            src={images.prairie}
            alt="Les chevaux dans les prés autour du gîte"
            loading="lazy"
          />

          <div class="gite-feature-stack">
            <article class="gite-feature">
              <div class="gite-icon" aria-hidden="true">
                <img src="/icons/lucide--calendar-days.svg" alt="" />
              </div>
              <h2>Un accueil toute l’année</h2>
              <p>
                Nous vous accueillons toute l’année, à la nuitée, en week-end ou
                pour plusieurs jours ou semaines, que vous soyez cavaliers,
                marcheurs, motards, vététistes ou simplement vacanciers.
              </p>
            </article>

            <article class="gite-feature">
              <div class="gite-icon gite-icon--horse" aria-hidden="true">
                <img src="/icons/hugeicons--horse-head.svg" alt="" />
              </div>
              <h2>Un accueil dédié<br />aux cavaliers</h2>
              <p>
                Pour les cavaliers, foin, granulés, paddocks, douche, boxes et
                sellerie sur place, maréchal-ferrant et dentiste équin sur place
                si besoin !
              </p>
            </article>
          </div>

          <img
            class="gite-feature-image"
            src={images.mezenc}
            alt="Le massif du Mézenc près du gîte"
            loading="lazy"
          />

          <div class="gite-feature-stack gite-feature-stack--location">
            <article class="gite-feature gite-feature--location">
              <div class="gite-icon" aria-hidden="true">
                <img src="/icons/lucide--mountain-snow.svg" alt="" />
              </div>
              <h2>Une situation idéale</h2>
              <p>
                Nous sommes situés à 1100 m d’altitude, à 30 min de la station de
                ski du Mézenc.
              </p>
            </article>

            <aside class="gite-restaurant">
              <div class="gite-restaurant-icon" aria-hidden="true">
                <img src="/icons/lucide--utensils.svg" alt="" />
              </div>
              <p>
                Un bar restaurant / pizzeria ouvert à l’année se trouve à 5 min en
                voiture, proposant aussi des plats à emporter ou livrés au gîte.
              </p>
            </aside>
          </div>
        </div>
      </section>

      <section class="gite-discovery">
        <h2>Une région riche en découvertes</h2>

        <div class="gite-discovery-top">
          <div class="gite-discovery-copy">
            <div class="gite-icon" aria-hidden="true">
              <img src="/icons/lucide--tent.svg" alt="" />
            </div>
            <p>
              De nombreux chemins de randonnées sont présents autour du village
              (Chemin de Stevenson, Saint-Jacques-de-Compostelle, GR40 et GR18).
            </p>
            <p>
              De nombreux coins à visiter comme le Lac Bleu, ainsi que des
              villages touristiques : le Lac d’Issarlès, Goudet, Coucouron ainsi
              que la ville du Puy-en-Velay située à 30 min.
            </p>
          </div>

          <div class="gite-media-placeholder gite-discovery-main">
            <span>PHOTO DE LA RÉGION</span>
          </div>
        </div>

        <div class="gite-gallery">
          <div class="gite-media-placeholder"><span>PHOTO</span></div>
          <div class="gite-media-placeholder"><span>PHOTO</span></div>
          <div class="gite-media-placeholder"><span>PHOTO</span></div>
        </div>
      </section>

      <section class="gite-booking">
        <div class="gite-booking-placeholder">
          <p>EMPLACEMENT DU MODULE DE RÉSERVATION</p>
          <a class="gite-booking-button" href="/contact">Nous contacter</a>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      const carousel = document.querySelector<HTMLElement>(".gite-interior-carousel");
      const slides = Array.from(
        document.querySelectorAll<HTMLImageElement>(".gite-interior-slide")
      );
      const dots = Array.from(
        document.querySelectorAll<HTMLButtonElement>(".gite-carousel-dot")
      );
      const previousButton = document.querySelector<HTMLButtonElement>(
        ".gite-carousel-arrow--previous"
      );
      const nextButton = document.querySelector<HTMLButtonElement>(
        ".gite-carousel-arrow--next"
      );
      const expandButton = document.querySelector<HTMLButtonElement>(
        ".gite-carousel-expand"
      );
      const lightbox = document.querySelector<HTMLDialogElement>(".gite-lightbox");
      const lightboxImage = document.querySelector<HTMLImageElement>(".gite-lightbox-image");
      const lightboxClose = document.querySelector<HTMLButtonElement>(".gite-lightbox-close");
      const lightboxPrevious = document.querySelector<HTMLButtonElement>(
        ".gite-lightbox-arrow--previous"
      );
      const lightboxNext = document.querySelector<HTMLButtonElement>(
        ".gite-lightbox-arrow--next"
      );

      let currentSlide = 0;
      let autoplay: number | undefined;
      let touchStartX = 0;

      const showSlide = (newIndex: number) => {
        if (slides.length === 0) return;

        currentSlide = (newIndex + slides.length) % slides.length;

        slides.forEach((slide, index) => {
          const isActive = index === currentSlide;
          slide.classList.toggle("is-active", isActive);
          slide.setAttribute("aria-hidden", String(!isActive));
        });

        dots.forEach((dot, index) => {
          const isActive = index === currentSlide;
          dot.classList.toggle("is-active", isActive);
          dot.setAttribute("aria-current", String(isActive));
        });

        if (lightbox?.open && lightboxImage) {
          lightboxImage.src = slides[currentSlide].src;
          lightboxImage.alt = slides[currentSlide].alt;
        }
      };

      const stopAutoplay = () => {
        if (autoplay) window.clearInterval(autoplay);
        autoplay = undefined;
      };

      const startAutoplay = () => {
        stopAutoplay();
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        autoplay = window.setInterval(() => showSlide(currentSlide + 1), 4500);
      };

      previousButton?.addEventListener("click", () => {
        showSlide(currentSlide - 1);
        startAutoplay();
      });

      nextButton?.addEventListener("click", () => {
        showSlide(currentSlide + 1);
        startAutoplay();
      });

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          showSlide(Number(dot.dataset.slide));
          startAutoplay();
        });
      });

      expandButton?.addEventListener("click", () => {
        if (!lightbox || !lightboxImage || slides.length === 0) return;
        stopAutoplay();
        lightboxImage.src = slides[currentSlide].src;
        lightboxImage.alt = slides[currentSlide].alt;
        lightbox.showModal();
      });

      lightboxClose?.addEventListener("click", () => lightbox?.close());
      lightboxPrevious?.addEventListener("click", () => showSlide(currentSlide - 1));
      lightboxNext?.addEventListener("click", () => showSlide(currentSlide + 1));

      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) lightbox.close();
      });

      lightbox?.addEventListener("close", startAutoplay);

      document.addEventListener("keydown", (event) => {
        if (!lightbox?.open) return;
        if (event.key === "ArrowLeft") showSlide(currentSlide - 1);
        if (event.key === "ArrowRight") showSlide(currentSlide + 1);
      });

      carousel?.addEventListener("mouseenter", stopAutoplay);
      carousel?.addEventListener("mouseleave", startAutoplay);
      carousel?.addEventListener("focusin", stopAutoplay);
      carousel?.addEventListener("focusout", startAutoplay);
      carousel?.addEventListener("touchstart", (event) => {
        touchStartX = event.touches[0]?.clientX || 0;
        stopAutoplay();
      }, { passive: true });
      carousel?.addEventListener("touchend", (event) => {
        const touchEndX = event.changedTouches[0]?.clientX || 0;
        const distance = touchEndX - touchStartX;
        if (Math.abs(distance) > 45) {
          showSlide(currentSlide + (distance < 0 ? 1 : -1));
        }
        startAutoplay();
      }, { passive: true });

      document.addEventListener("visibilitychange", () => {
        document.hidden ? stopAutoplay() : startAutoplay();
      });

      startAutoplay();
    </script>
  </body>
</html>
