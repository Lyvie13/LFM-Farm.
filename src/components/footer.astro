---
import CookieConsent from "./CookieConsent.astro";
---

<footer class="site-footer">
  <img
    class="footer-background"
      src="https://res.cloudinary.com/dhmehfgjo/image/upload/v1786695959/wood.png"
    alt=""
  />

  <div class="footer-overlay"></div>

  <div class="footer-container">
    <div class="footer-main">
      <div class="footer-brand">
        <strong>LFM FARM</strong>
        <span>Élevage de Paint Horse</span>

        <div class="footer-socials" aria-label="Réseaux sociaux de LFM Farm">
          <a
            href="https://www.instagram.com/lfm_farm/?utm_source=ig_web_button_share_sheet"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Suivre LFM Farm sur Instagram"
          >
            <img src="/icons/lets-icons--insta.svg" alt="" />
          </a>

          <a
            href="https://www.facebook.com/media/set/?set=a.1476159574300721&type=3"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Suivre LFM Farm sur Facebook"
          >
            <img src="/icons/akar-icons--facebook-fill.svg" alt="" />
          </a>
        </div>
      </div>

      <address class="footer-contact">
        <a
          href="https://maps.google.com/?q=Lieu+dit+Maiguezin+43150+Salettes"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img src="/icons/lucide--map-pin.svg" alt="" />
          <span>Lieu dit Maiguezin, 43150 Salettes</span>
        </a>

        <div class="footer-contact-row">
          <img src="/icons/lucide--phone.svg" alt="" />

          <span>
            <a href="tel:+33628331162">06.28.33.11.62</a>
            /
            <a href="tel:+33634961727">06.34.96.17.27</a>
          </span>
        </div>

        <a href="mailto:contact@lfmfarm.fr">
          <img src="/icons/lucide--mail.svg" alt="" />
          <span>contact@lfmfarm.fr</span>
        </a>
      </address>
    </div>

    <div class="footer-bottom">
      <span>© 2026</span>

      <a href="/politique-de-confidentialite">
        Politique de confidentialité
      </a>

      <a href="/mentions-legales">
        Mentions légales
      </a>

      <span>
        Site pensé et conçu par : 
        <a
          href="https://lyviestudio.fr"
          target="_blank"
          rel="noopener noreferrer"
        >
          Lyvie Studio
        </a>
      </span>
    </div>
  </div>
</footer>

<CookieConsent />

<style>
  .site-footer {
    position: relative;
    min-height: 275px;
    overflow: hidden;
    color: white;
  }

  .footer-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .footer-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(40, 17, 8, 0.32);
  }

  .footer-container {
    position: relative;
    z-index: 1;
    width: min(90%, 1200px);
    min-height: 275px;
    margin: 0 auto;
    padding: 45px 0 18px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-brand strong {
    font-family: Arial, sans-serif;
    font-size: 23px;
  }

  .footer-brand span {
    font-family: Arial, sans-serif;
    font-size: 17px;
  }

  .footer-socials {
    display: flex;
    gap: 12px;
    margin-top: 10px;
  }

  .footer-socials a {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.75);
    border-radius: 50%;
    background-color: rgba(168, 63, 29, 0.78);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .footer-socials a:hover {
    background-color: #a83f1d;
    transform: translateY(-2px);
  }

  .footer-socials img {
    width: 20px;
    height: 20px;
    filter: brightness(0) invert(1);
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 22px;
    margin: 0;
    font-style: normal;
  }

  .footer-contact > a,
  .footer-contact-row {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .footer-contact img {
    flex-shrink: 0;
    width: 23px;
    height: 23px;
    filter: brightness(0) invert(1);
  }

  .footer-contact a {
    color: white;
    font-family: Arial, sans-serif;
    font-size: 15px;
    text-decoration: none;
  }

  .footer-contact a:hover {
    text-decoration: underline;
  }

  .footer-bottom {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 28px;

    font-family: Arial, sans-serif;
    font-size: 11px;
  }

  .footer-bottom a {
    color: white;
    text-decoration: underline;
  }

  @media (max-width: 700px) {
    .site-footer,
    .footer-container {
      min-height: auto;
    }

    .footer-container {
      width: 90%;
      padding: 35px 0 24px;
    }

    .footer-main {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .footer-contact {
      gap: 16px;
    }

    .footer-contact a,
    .footer-contact-row {
      font-size: 13px;
    }

    .footer-bottom {
      margin-top: 35px;
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
  }

</style>
