---
import Navbar from "../components/navbar.astro";
import Footer from "../components/footer.astro";

import { contentfulClient } from "../lib/contentful";

import "../styles/global.css";
import "../styles/etalons.css";

const titre = "LFM Farm / Poulains";

const response = await contentfulClient.getEntries({
  content_type: "poulains",
});

const poulains = response.items
  .filter(
    (poulain: any) =>
      poulain.fields.afficherSurLeSite !== false
  )
  .sort(
    (a: any, b: any) =>
      (a.fields.ordre || 999) -
      (b.fields.ordre || 999)
  );

const sexes = [...new Set(
  poulains.map((poulain: any) => poulain.fields.sexe).filter(Boolean)
)].sort((a: any, b: any) => a.localeCompare(b, "fr"));

const statuts = [...new Set(
  poulains.map((poulain: any) => poulain.fields.statut).filter(Boolean)
)].sort((a: any, b: any) => a.localeCompare(b, "fr"));

const annees = [...new Set(
  poulains
    .map((poulain: any) => poulain.fields.dateNaissance?.slice(0, 4))
    .filter(Boolean)
)].sort((a: any, b: any) => Number(b) - Number(a));

const getImageUrl = (url: string | undefined) => {
  if (!url) return "";
  if (url.startsWith("//")) return `https:${url}`;

  return url;
};

const accorderStatut = (statut: string | undefined, sexe: string | undefined) => {
  if (!statut) return "";

  const estFemelle = (sexe || "").trim().toLocaleLowerCase("fr").startsWith("f");
  const estReserve = /^r[eé]serv[eé]$/i.test(statut.trim());

  if (!estFemelle || !estReserve) return statut;
  if (statut === statut.toLocaleUpperCase("fr")) return "RÉSERVÉE";
  if (/^[A-ZÀ-ÖØ-Þ]/.test(statut)) return "Réservée";
  return "réservée";
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <meta name="description" content="Découvrez les poulains Paint Horse nés à LFM Farm, leurs origines, leurs caractéristiques et leur évolution." />

    <title>{titre}</title>
  </head>

  <body>
    <Navbar />

    <main>
      <section class="horses-hero horses-hero--foals">
        <img
          class="horses-hero-image"
          src="https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666755/poulain_hero.jpg"
          alt="Un poulain de LFM Farm dans sa prairie"
        />

        <div class="horses-hero-overlay"></div>

        <div class="horses-hero-content">
          <h1>NOS POULAINS</h1>
          <p>Découvrez les poulains nés à LFM Farm.</p>
        </div>
      </section>

      <section class="etalons-section">
        <div class="foals-filters" aria-label="Filtrer les poulains">
          <div class="foals-filter-field">
            <label for="filter-sex">Sexe</label>
            <select id="filter-sex">
              <option value="">Tous</option>
              {sexes.map((sexe: any) => <option value={sexe}>{sexe}</option>)}
            </select>
          </div>

          <div class="foals-filter-field">
            <label for="filter-status">Disponibilité</label>
            <select id="filter-status">
              <option value="">Toutes</option>
              {statuts.map((statut: any) => <option value={statut}>{statut}</option>)}
            </select>
          </div>

          <div class="foals-filter-field">
            <label for="filter-year">Année de naissance</label>
            <select id="filter-year">
              <option value="">Toutes</option>
              {annees.map((annee: any) => <option value={annee}>{annee}</option>)}
            </select>
          </div>

          <div class="foals-filter-field">
            <label for="filter-sort">Trier par</label>
            <select id="filter-sort">
              <option value="default">Ordre du site</option>
              <option value="newest">Plus récents</option>
              <option value="oldest">Plus anciens</option>
              <option value="name">Nom</option>
            </select>
          </div>

          <button id="reset-filters" class="foals-filters-reset" type="button">
            Réinitialiser
          </button>
        </div>

        <p id="foals-results-count" class="foals-results-count" aria-live="polite"></p>

        <div id="foals-grid" class="etalons-grid">
          {
            poulains.length > 0 ? (
              poulains.map((poulain: any, index: number) => {
                const fields = poulain.fields;
                const anneeNaissance = fields.dateNaissance?.slice(0, 4) || "";
                const statutAffiche = accorderStatut(fields.statut, fields.sexe);

                const photo = getImageUrl(
                  fields.photoPrincipale
                    ?.fields?.file?.url
                );

                return (
                  <article
                    class="etalon-card foal-card"
                    data-sex={fields.sexe || ""}
                    data-status={fields.statut || ""}
                    data-year={anneeNaissance}
                    data-birth-date={fields.dateNaissance || ""}
                    data-name={fields.nom || ""}
                    data-index={index}
                  >
                    {photo && (
                      <img
                        class="etalon-card-image"
                        src={photo}
                        alt={`Poulain ${fields.nom || ""}`}
                        loading="lazy"
                      />
                    )}

                    <div class="etalon-card-content">
                      <h2>{fields.nom}</h2>

                      {fields.sexe && (
                        <p class="etalon-card-genotype foal-card-meta">
                          {fields.sexe}{statutAffiche && ` · ${statutAffiche}`}
                        </p>
                      )}

                      {(fields.descriptionCourte || fields.description) && (
                        <p class="etalon-card-description">
                          {fields.descriptionCourte || fields.description}
                        </p>
                      )}

                      {fields.slug && (
                        <a
                          class="etalon-card-button"
                          href={`/poulains/${fields.slug}`}
                        >
                          DÉCOUVRIR
                        </a>
                      )}
                    </div>
                  </article>
                );
              })
            ) : (
              <p class="etalons-empty">
                Aucun poulain n’est actuellement présenté.
              </p>
            )
          }

          <p id="foals-no-results" class="etalons-empty foals-no-results" hidden>
            Aucun poulain ne correspond à ces filtres.
          </p>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      const sexFilter = document.querySelector("#filter-sex") as HTMLSelectElement;
      const statusFilter = document.querySelector("#filter-status") as HTMLSelectElement;
      const yearFilter = document.querySelector("#filter-year") as HTMLSelectElement;
      const sortFilter = document.querySelector("#filter-sort") as HTMLSelectElement;
      const resetButton = document.querySelector("#reset-filters") as HTMLButtonElement;
      const grid = document.querySelector("#foals-grid") as HTMLElement;
      const cards = Array.from(document.querySelectorAll(".foal-card")) as HTMLElement[];
      const noResults = document.querySelector("#foals-no-results") as HTMLElement;
      const resultsCount = document.querySelector("#foals-results-count") as HTMLElement;

      const updateFoals = () => {
        const visibleCards = cards.filter((card) => {
          const matchesSex = !sexFilter.value || card.dataset.sex === sexFilter.value;
          const matchesStatus = !statusFilter.value || card.dataset.status === statusFilter.value;
          const matchesYear = !yearFilter.value || card.dataset.year === yearFilter.value;
          const isVisible = matchesSex && matchesStatus && matchesYear;
          card.hidden = !isVisible;
          return isVisible;
        });

        const sortedCards = [...visibleCards].sort((a, b) => {
          if (sortFilter.value === "newest") {
            return (b.dataset.birthDate || "").localeCompare(a.dataset.birthDate || "");
          }
          if (sortFilter.value === "oldest") {
            return (a.dataset.birthDate || "").localeCompare(b.dataset.birthDate || "");
          }
          if (sortFilter.value === "name") {
            return (a.dataset.name || "").localeCompare(b.dataset.name || "", "fr");
          }
          return Number(a.dataset.index) - Number(b.dataset.index);
        });

        sortedCards.forEach((card) => grid.appendChild(card));
        grid.appendChild(noResults);
        noResults.hidden = visibleCards.length !== 0;
        resultsCount.textContent = `${visibleCards.length} poulain${visibleCards.length > 1 ? "s" : ""} affiché${visibleCards.length > 1 ? "s" : ""}`;
      };

      [sexFilter, statusFilter, yearFilter, sortFilter].forEach((filter) => {
        filter?.addEventListener("change", updateFoals);
      });

      resetButton?.addEventListener("click", () => {
        sexFilter.value = "";
        statusFilter.value = "";
        yearFilter.value = "";
        sortFilter.value = "default";
        updateFoals();
      });

      updateFoals();
    </script>
  </body>
</html>
