    padding: 20px;
    background: rgba(35, 17, 10, 0.42);
  }

  .cookie-banner__content {
    width: min(100%, 760px);
    padding: 25px;
    border-radius: 12px;
    background: #fff8ef;
    box-shadow: 0 8px 30px rgba(35, 17, 10, 0.28);
    color: #51210f;
  }

  .cookie-banner h2 {
    margin: 0 0 10px;
    font-family: Baskerville, "Baskerville Old Face", Georgia, serif;
    font-size: 28px;
  }

  .cookie-banner p {
    margin: 0 0 18px;
    color: #35251e;
    font-family: Arial, sans-serif;
    font-size: 15px;
    line-height: 1.45;
  }

  .cookie-preferences {
    margin: 15px 0;
    padding: 15px;
    border: 1px solid #d9b9a6;
    border-radius: 8px;
  }

  .cookie-preferences label {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: #35251e;
    font-family: Arial, sans-serif;
  }

  .cookie-preferences input {
    width: 19px;
    height: 19px;
    accent-color: #a83f1d;
  }

  .cookie-preferences span {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cookie-preferences small {
    font-size: 13px;
  }

  .cookie-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 15px;
  }

  .cookie-button,
  .cookie-manage {
    border: 1px solid #a83f1d;
    border-radius: 8px;
    background: #a83f1d;
    color: white;
    cursor: pointer;
    font-family: Arial, sans-serif;
    font-weight: 700;
  }

  .cookie-button {
    min-height: 44px;
    padding: 10px 18px;
  }

  .cookie-button--secondary {
    background: transparent;
    color: #a83f1d;
  }

  .cookie-banner a {
    color: #7c2d12;
    font-family: Arial, sans-serif;
    font-size: 13px;
  }

  .cookie-manage {
    position: fixed;
    left: 14px;
    bottom: 14px;
    z-index: 9999;
    padding: 9px 13px;
    font-size: 12px;
    box-shadow: 0 4px 14px rgba(35, 17, 10, 0.22);
  }

  :global(.cookie-placeholder) {
    width: 100%;
    min-height: 190px;
    padding: 25px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border: 1px solid #d9b9a6;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.62);
    color: #51210f;
    text-align: center;
    font-family: Arial, sans-serif;
  }

  :global(.cookie-placeholder button) {
    padding: 10px 16px;
    border: 0;
    border-radius: 7px;
    background: #a83f1d;
    color: white;
    cursor: pointer;
    font-weight: 700;
  }

  @media (max-width: 600px) {
    .cookie-banner {
      padding: 10px;
    }

    .cookie-banner__content {
      padding: 20px;
    }

    .cookie-banner__actions {
      display: grid;
      grid-template-columns: 1fr;
    }
  }
</style>
