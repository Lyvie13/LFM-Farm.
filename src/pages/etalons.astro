---
import Navbar from "../components/navbar.astro";
import Footer from "../components/footer.astro";
import { contentfulClient } from "../lib/contentful";

import "../styles/global.css";
import "../styles/etalons.css";
const titre = "LFM Farm / Étalons";

/* Récupération uniquement des étalons */
const response = await contentfulClient.getEntries({
  content_type: "etalons",
});

const etalons = response.items
  .filter((etalon: any) => etalon.fields.afficherSurLeSite !== false)
  .sort(
    (a: any, b: any) =>
      (a.fields.ordre || 999) - (b.fields.ordre || 999)
  );

/* Transforme l’adresse Contentful en adresse complète */
const getImageUrl = (url: string | undefined) => {
  if (!url) return "";
  if (url.startsWith("//")) return `https:${url}`;

  return url;
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <meta name="description" content="Découvrez les étalons Paint Horse sélectionnés par LFM Farm pour leurs qualités, leurs origines et leur génétique." />

    <title>{titre}</title>
  </head>

  <body>
    <Navbar />

    <main>
      <section class="horses-hero horses-hero--stallions">
        <img
          class="horses-hero-image"
          src="https://res.cloudinary.com/dhmehfgjo/image/upload/v1787688404/488885043_1172073574709324_4872981332713241984_n_pjhivi.jpg"
          alt="Les étalons de LFM Farm dans leur prairie"
        />

        <div class="horses-hero-overlay"></div>

        <div class="horses-hero-content">
          <h1>NOS ÉTALONS</h1>
          <p>Des lignées d’exception.</p>
        </div>
      </section>

      <section class="etalons-section">
        <div class="etalons-grid">
          {
            etalons.length > 0 ? (
              etalons.map((etalon: any) => {
                const fields = etalon.fields;

                const photo = getImageUrl(
                  fields.photoPrincipale?.fields?.file?.url
                );

                return (
                  <article class="etalon-card">
                    {photo && (
                      <img
                        class="etalon-card-image"
                        src={photo}
                        alt={`Étalon ${fields.nom || ""}`}
                        loading="lazy"
                      />
                    )}

                    <div class="etalon-card-content">
                      <h2>{fields.nom}</h2>

                      {fields.genotype && (
                        <p class="etalon-card-genotype">
                          {fields.genotype}
                        </p>
                      )}

                      {fields.description && (
                        <p class="etalon-card-description">
                          {fields.description}
                        </p>
                      )}

                      {fields.slug && (
                        <a
                          class="etalon-card-button"
                          href={`/etalons/${fields.slug}`}
                        >
                          DÉCOUVRIR
                        </a>
                      )}
                    </div>
                  </article>
                );
              })
            ) : (
              <p class="etalons-empty">
                Aucun étalon n’est actuellement présenté.
              </p>
            )
          }
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
