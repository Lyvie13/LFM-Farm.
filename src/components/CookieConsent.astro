<div class="cookie-banner" data-cookie-banner hidden>
  <div class="cookie-banner__content">
    <h2>Votre vie privée</h2>
    <p>
      Nous utilisons des services externes pour afficher les avis clients et la
      carte Google Maps. Vous pouvez accepter ou refuser leur chargement.
    </p>

    <div class="cookie-preferences" data-cookie-preferences hidden>
      <label>
        <input type="checkbox" data-cookie-external />
        <span>
          <strong>Contenus externes</strong>
          <small>Elfsight (avis clients) et Google Maps</small>
        </span>
      </label>
    </div>

    <div class="cookie-banner__actions">
      <button type="button" class="cookie-button" data-cookie-reject>
        Tout refuser
      </button>
      <button type="button" class="cookie-button cookie-button--secondary" data-cookie-customize>
        Personnaliser
      </button>
      <button type="button" class="cookie-button" data-cookie-accept>
        Tout accepter
      </button>
      <button type="button" class="cookie-button" data-cookie-save hidden>
        Enregistrer mes choix
      </button>
    </div>

    <a href="/politique-de-confidentialite">En savoir plus</a>
  </div>
</div>

<button type="button" class="cookie-manage" data-cookie-open hidden>
  Gérer mes cookies
</button>

<script is:inline>
  (() => {
    const storageKey = "lfm-cookie-consent";
    const consentDuration = 180 * 24 * 60 * 60 * 1000;
    const banner = document.querySelector("[data-cookie-banner]");
    const preferences = document.querySelector("[data-cookie-preferences]");
    const externalCheckbox = document.querySelector("[data-cookie-external]");
    const manageButton = document.querySelector("[data-cookie-open]");
    const saveButton = document.querySelector("[data-cookie-save]");
    const customizeButton = document.querySelector("[data-cookie-customize]");
    const acceptButton = document.querySelector("[data-cookie-accept]");
    const rejectButton = document.querySelector("[data-cookie-reject]");

    if (!banner || !externalCheckbox) return;

    const readChoice = () => {
      try {
        const choice = JSON.parse(localStorage.getItem(storageKey));

        if (
          !choice?.savedAt ||
          Date.now() - new Date(choice.savedAt).getTime() > consentDuration
        ) {
          localStorage.removeItem(storageKey);
          return null;
        }

        return choice;
      } catch {
        return null;
      }
    };

    const enableExternalMedia = () => {
      document.querySelectorAll("[data-cookie-src]").forEach((element) => {
        if (!element.getAttribute("src")) {
          element.setAttribute("src", element.dataset.cookieSrc);
        }
      });

      document.querySelectorAll("[data-cookie-script]").forEach((element) => {
        if (element.dataset.loaded === "true") return;

        const script = document.createElement("script");
        script.src = element.dataset.src;
        script.async = true;
        document.head.appendChild(script);
        element.dataset.loaded = "true";
      });

      document.querySelectorAll("[data-cookie-placeholder]").forEach((element) => {
        element.hidden = true;
      });
    };

    const closeBanner = () => {
      banner.hidden = true;
      manageButton.hidden = false;
    };

    const saveChoice = (externalMedia) => {
      const previousChoice = readChoice();
      localStorage.setItem(
        storageKey,
        JSON.stringify({ externalMedia, savedAt: new Date().toISOString() })
      );

      if (externalMedia) enableExternalMedia();
      closeBanner();

      if (previousChoice?.externalMedia && !externalMedia) {
        window.location.reload();
      }
    };

    const openPreferences = () => {
      const choice = readChoice();
      externalCheckbox.checked = Boolean(choice?.externalMedia);
      preferences.hidden = false;
      customizeButton.hidden = true;
      acceptButton.hidden = true;
      saveButton.hidden = false;
      banner.hidden = false;
      manageButton.hidden = true;
    };

    acceptButton.addEventListener("click", () => saveChoice(true));
    rejectButton.addEventListener("click", () => saveChoice(false));
    customizeButton.addEventListener("click", openPreferences);
    saveButton.addEventListener("click", () => saveChoice(externalCheckbox.checked));
    manageButton.addEventListener("click", openPreferences);

    document.addEventListener("click", (event) => {
      if (event.target.closest(".js-cookie-settings")) openPreferences();
    });

    const choice = readChoice();
    if (!choice) {
      banner.hidden = false;
    } else {
      manageButton.hidden = false;
      if (choice.externalMedia) enableExternalMedia();
    }
  })();
</script>

<style>
  .cookie-banner[hidden],
  .cookie-manage[hidden],
  .cookie-preferences[hidden],
  .cookie-button[hidden],
  :global([data-cookie-placeholder][hidden]) {
