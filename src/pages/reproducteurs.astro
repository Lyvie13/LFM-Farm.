---
import Navbar from "../components/navbar.astro";
import Footer from "../components/footer.astro";
import '../styles/global.css';
import '../styles/reproducteurs.css';
const titre = 'LFM Farm / Reproducteurs';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Découvrez les étalons et poulinières Paint Horse qui composent la sélection de reproducteurs de LFM Farm." />
    <title>{titre}</title>
  </head>
  <body>
    <Navbar />

    <main>
<section class="breeders-hero">
  <img
    class="breeders-hero-image"
    src="https://res.cloudinary.com/dhmehfgjo/image/upload/v1787667340/etalon_hero.jpg"
    alt="Les reproducteurs de LFM Farm dans leur prairie"
  />

  <div class="breeders-hero-overlay"></div>

  <div class="breeders-hero-content">
    <h1>REPRODUCTEURS</h1>
    <p>Des lignées d’exception</p>
  </div>
</section>

<section class="breeder-selection">
  <div class="breeder-selection-container">
    <div class="breeder-selection-grid">
      <!-- Carte étalons -->

      <article class="breeder-selection-card">
        <div class="breeder-selection-content">
          <h2>ÉTALONS</h2>
          <div class="breeder-selection-line"></div>

          <p>
            Découvrez nos étalons et<br />
            leurs pédigrées prestigieux.
          </p>

          <a class="breeder-selection-button" href="/etalons">
            DÉCOUVRIR
          </a>
        </div>

        <img
          class="breeder-selection-horse breeder-selection-horse--stallion"
          src="https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666530/etalon.png"
          alt="Un étalon Paint Horse"
        />
      </article>

      <!-- Carte poulinières -->

      <article class="breeder-selection-card">
        <div class="breeder-selection-content">
          <h2>POULINIÈRES</h2>
          <div class="breeder-selection-line"></div>

          <p>
            Découvrez nos poulinières sélectionnées
            pour leur qualité et leur génétique.
          </p>

          <a class="breeder-selection-button" href="/poulinieres">
            DÉCOUVRIR
          </a>
        </div>

        <img
          class="breeder-selection-horse breeder-selection-horse--mare"
          src="https://res.cloudinary.com/dhmehfgjo/image/upload/v1787667415/pouliniere_card.png"
          alt="Une poulinière Paint Horse"
        />
      </article>
    </div>

    <a class="breeding-season-button" href="/mariage">
      VOIR LES MARIAGES 2027
    </a>
  </div>
</section>
    </main>
    <Footer />
  </body>
</html>
