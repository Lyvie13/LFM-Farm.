---
import Navbar from "../components/navbar.astro";
import Footer from "../components/footer.astro";
import { contentfulClient } from "../lib/contentful";

import "../styles/global.css";
import "../styles/etalons.css";

const titre = "LFM Farm / Poulinières";

/* Récupération uniquement des poulinières */
const response = await contentfulClient.getEntries({
  content_type: "poulinieres",
});

const poulinieres = response.items
  .filter(
    (pouliniere: any) =>
      pouliniere.fields.afficherSurLeSite !== false
  )
  .sort(
    (a: any, b: any) =>
      (a.fields.ordre || 999) -
      (b.fields.ordre || 999)
  );

const getImageUrl = (url: string | undefined) => {
  if (!url) return "";
  if (url.startsWith("//")) return `https:${url}`;

  return url;
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <meta name="description" content="Découvrez les poulinières Paint Horse de LFM Farm, sélectionnées pour leurs qualités, leurs origines et leur génétique." />

    <title>{titre}</title>
  </head>

  <body>
    <Navbar />

    <main>
      <section class="horses-hero horses-hero--mares">
        <img
          class="horses-hero-image"
          src="https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666972/pouliniere_hero.jpg"
          alt="Une poulinière et son poulain à LFM Farm"
        />

        <div class="horses-hero-overlay"></div>

        <div class="horses-hero-content">
          <h1>NOS POULINIÈRES</h1>
          <p>Une sélection fondée sur la qualité.</p>
        </div>
      </section>

      <section class="etalons-section">
        <div class="foals-filters" aria-label="Filtrer les poulinières">
          <div class="foals-filter-field">
            <label for="mare-filter-name">Rechercher par nom</label>
            <input
              id="mare-filter-name"
              type="search"
              placeholder="Nom de la poulinière"
              autocomplete="off"
            />
          </div>

          <button id="mare-reset-filters" class="foals-filters-reset" type="button">
            Réinitialiser
          </button>
        </div>

        <p id="mares-results-count" class="foals-results-count" aria-live="polite"></p>

        <div id="mares-grid" class="etalons-grid">
          {
            poulinieres.length > 0 ? (
              poulinieres.map((pouliniere: any, index: number) => {
                const fields = pouliniere.fields;

                const photo = getImageUrl(
                  fields.photoPrincipale
                    ?.fields?.file?.url
                );

                return (
                  <article
                    class="etalon-card mare-card"
                    data-name={fields.nom || ""}
                    data-index={index}
                  >
                    {photo && (
                      <img
                        class="etalon-card-image"
                        src={photo}
                        alt={`Poulinière ${fields.nom || ""}`}
                        loading="lazy"
                      />
                    )}

                    <div class="etalon-card-content">
                      <h2>{fields.nom}</h2>

                      {fields.genotype && (
                        <p class="etalon-card-genotype">
                          {fields.genotype}
                        </p>
                      )}

                      {fields.description && (
                        <p class="etalon-card-description">
                          {fields.description}
                        </p>
                      )}

                      {fields.slug && (
                        <a
                          class="etalon-card-button"
                          href={`/poulinieres/${fields.slug}`}
                        >
                          DÉCOUVRIR
                        </a>
                      )}
                    </div>
                  </article>
                );
              })
            ) : (
              <p class="etalons-empty">
                Aucune poulinière n’est actuellement présentée.
              </p>
            )
          }

          <p id="mares-no-results" class="etalons-empty foals-no-results" hidden>
            Aucune poulinière ne correspond à ces filtres.
          </p>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      const nameFilter = document.querySelector("#mare-filter-name") as HTMLInputElement;
      const resetButton = document.querySelector("#mare-reset-filters") as HTMLButtonElement;
      const grid = document.querySelector("#mares-grid") as HTMLElement;
      const cards = Array.from(document.querySelectorAll(".mare-card")) as HTMLElement[];
      const noResults = document.querySelector("#mares-no-results") as HTMLElement;
      const resultsCount = document.querySelector("#mares-results-count") as HTMLElement;

      const normalize = (value: string) => value
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLocaleLowerCase("fr");

      const updateMares = () => {
        const searchedName = normalize(nameFilter.value.trim());
        const visibleCards = cards.filter((card) => {
          const isVisible = !searchedName || normalize(card.dataset.name || "").includes(searchedName);
          card.hidden = !isVisible;
          return isVisible;
        });

        const sortedCards = [...visibleCards].sort(
          (a, b) => Number(a.dataset.index) - Number(b.dataset.index)
        );

        sortedCards.forEach((card) => grid.appendChild(card));
        grid.appendChild(noResults);
        noResults.hidden = visibleCards.length !== 0;
        resultsCount.textContent = `${visibleCards.length} poulinière${visibleCards.length > 1 ? "s" : ""} affichée${visibleCards.length > 1 ? "s" : ""}`;
      };

      nameFilter?.addEventListener("input", updateMares);

      resetButton?.addEventListener("click", () => {
        nameFilter.value = "";
        updateMares();
        nameFilter.focus();
      });

      updateMares();
    </script>
  </body>
</html>
