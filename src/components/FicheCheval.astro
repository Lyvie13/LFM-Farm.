---
const {
  cheval,
  typeCheval,
  lienRetour,
  texteRetour,
} = Astro.props;

const fields = cheval.fields;

/* =========================
   IMAGES CONTENTFUL
========================= */

const getImageUrl = (image: any) => {
  const url = image?.fields?.file?.url;

  if (!url) return "";

  if (url.startsWith("//")) {
    return `https:${url}`;
  }

  return url;
};

const photoPrincipale = getImageUrl(
  fields.photoPrincipale
);

const galerie =
  fields.galerie ||
  fields.photos ||
  fields.galeriePhotos ||
  [];

/* =========================
   INFORMATIONS GÉNÉRALES
========================= */

const description =
  fields.descriptionCourte ||
  fields.description ||
  "";

const informations =
  fields.resultatsGenetiques ||
  fields.informations ||
  fields.informationsComplementaires ||
  "";

const lienFacebook =
  fields.lienFacebook ||
  fields.facebook ||
  "";

/* =========================
   PARENTS
========================= */

const getNomParent = (parent: any) => {
  if (!parent) return "";

  if (parent?.fields?.nom) {
    return parent.fields.nom;
  }

  if (typeof parent === "string") {
    return parent;
  }

  return "";
};

const pere = getNomParent(fields.pere);
const mere = getNomParent(fields.mere);

/* =========================
   DATE DE NAISSANCE
========================= */

const dateNaissance = fields.dateNaissance
  ? new Date(fields.dateNaissance).toLocaleDateString(
      "fr-FR",
      {
        day: "numeric",
        month: "long",
        year: "numeric",
      }
    )
  : "";

const sexe = fields.sexe || "";

const texteNaissance =
  sexe.toLowerCase().startsWith("f")
    ? "Née le"
    : "Né le";
---

<main>
  <div class="horse-back">
    <a href={lienRetour}>
      ← {texteRetour}
    </a>
  </div>

  <section class="horse-detail">

    <!-- =========================
         PHOTOS
    ========================== -->

    <div class="horse-gallery">
      {
        photoPrincipale ? (
          <img
            id="horse-main-image"
            class="horse-main-image"
            src={photoPrincipale}
            alt={`${typeCheval} ${fields.nom || ""}`}
          />
        ) : (
          <div class="horse-no-image">
            Aucune photo disponible
          </div>
        )
      }

      {
        galerie.length > 0 && (
          <div class="horse-thumbnails">
            {galerie.map((photo: any) => {
              const photoUrl = getImageUrl(photo);

              return (
                photoUrl && (
                  <button
                    class="horse-thumbnail-button"
                    type="button"
                    data-image={photoUrl}
                    aria-label={`Afficher une autre photo de ${fields.nom}`}
                  >
                    <img
                      src={photoUrl}
                      alt={`${fields.nom} à LFM Farm`}
                      loading="lazy"
                    />
                  </button>
                )
              );
            })}
          </div>
        )
      }
    </div>

    <!-- =========================
         INFORMATIONS
    ========================== -->

    <div class="horse-information">
      <p class="horse-type">
        {typeCheval}
      </p>

      <h1>{fields.nom}</h1>

      {
        (sexe || dateNaissance) && (
          <p class="horse-summary">
            {sexe}

            {sexe && dateNaissance && " – "}

            {
              dateNaissance &&
              `${texteNaissance} ${dateNaissance}`
            }
          </p>
        )
      }

      {
        description && (
          <p class="horse-description">
            {description}
          </p>
        )
      }

      {
        fields.robe && (
          <p class="horse-coat">
            <strong>Robe :</strong>{" "}
            {fields.robe}
          </p>
        )
      }

      <!-- PARENTS -->

      {
        (pere || mere) && (
          <div class="horse-parents">
            {
              pere && (
                <p>
                  <strong>Père :</strong>{" "}
                  {pere}
                </p>
              )
            }

            {
              mere && (
                <p>
                  <strong>Mère :</strong>{" "}
                  {mere}
                </p>
              )
            }
          </div>
        )
      }

      <!-- GÉNOTYPE -->

      {
        fields.genotype && (
          <div class="horse-extra">
            <h2>Génotype</h2>

            <p>{fields.genotype}</p>
          </div>
        )
      }

      <!-- INFORMATIONS COMPLÉMENTAIRES -->

      {
        informations && (
          <div class="horse-extra">
            <h2>Informations</h2>

            <p>{informations}</p>
          </div>
        )
      }

      <!-- STATUT DU POULAIN -->

      {
        fields.statut && (
          <p class="horse-status">
            {fields.statut}
          </p>
        )
      }

      <!-- PRIX -->

      {
        fields.prix && (
          <p class="horse-price">
            {fields.prix}
          </p>
        )
      }

      <!-- FACEBOOK -->

      {
        lienFacebook && (
          <a
            class="horse-facebook"
            href={lienFacebook}
            target="_blank"
            rel="noopener noreferrer"
          >
            Voir plus de photos ou suivre son évolution sur Facebook
          </a>
        )
      }

      <!-- BOUTON DE CONTACT -->

      {
        fields.reservable !== false && (
          <a
            class="horse-contact-button"
            href="/contact"
          >
            NOUS CONTACTER
          </a>
        )
      }
    </div>
  </section>
</main>

<!-- =========================
     CHANGEMENT DE PHOTO
========================== -->

<script>
  const imagePrincipale =
    document.querySelector<HTMLImageElement>(
      "#horse-main-image"
    );

  const miniatures =
    document.querySelectorAll<HTMLButtonElement>(
      ".horse-thumbnail-button"
    );

  miniatures.forEach((miniature) => {
    miniature.addEventListener("click", () => {
      const nouvelleImage =
        miniature.dataset.image;

      if (imagePrincipale && nouvelleImage) {
        imagePrincipale.src = nouvelleImage;
      }
    });
  });
</script>