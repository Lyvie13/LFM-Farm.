---
import Navbar from "../components/navbar.astro";
import Footer from "../components/footer.astro";
import '../styles/global.css';
import '../styles/reproducteurs.css';
import MarriageCard from "../components/MarriageCard.astro";  
import { contentfulClient } from "../lib/contentful";
const response = await contentfulClient.getEntries({
  content_type: "mariage",
  include: 2,
});

const mariages = response.items
  .filter((mariage: any) => mariage.fields.afficher !== false)
  .sort(
    (a: any, b: any) =>
      (a.fields.ordre || 999) - (b.fields.ordre || 999)
  );
const titre = 'LFM Farm / Mariage';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{titre}</title>
  </head>
  <body>
    <nav>
      <Navbar />
    </nav>  
    <main>
<section class="breeders-hero breeding-year-hero">
  <img
    class="breeders-hero-image"
    src="LIEN_CLOUDINARY_MARIAGE"
    alt="Un étalon et une poulinière de LFM Farm"
  />

  <div class="breeders-hero-overlay"></div>

  <div class="breeders-hero-content">
    <h1>
      Mariage<br />
      2027
    </h1>

    <p>Des lignées d’exception</p>
  </div>
</section>

<section class="marriages-section">
  <div class="marriages-container">
    {
      mariages.length > 0 ? (
        mariages.map((mariage) => (
          <MarriageCard mariage={mariage} />
        ))
      ) : (
        <p class="marriages-empty">
          Aucun mariage n’est actuellement annoncé.
        </p>
      )
    }
  </div>
</section>

    </main>
    <footer>
      <Footer />
    </footer>
  </body>
</html>