<header class="site-header">
  <a class="logo-link" href="/" aria-label="Accueil LFM Farm">
    <img
      class="logo"
      src="https://res.cloudinary.com/dhmehfgjo/image/upload/v1782482724/logo_noir_bm7a2w.svg"
      alt="Logo LFM Farm"
    />
  </a>

  <button
    class="menu-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="main-navigation"
    aria-label="Ouvrir le menu"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <nav id="main-navigation" class="main-navigation" aria-label="Navigation principale">
    <a href="/">Accueil</a>
    <a href="/a-propos">À propos</a>
    <a href="/reproducteurs">Reproducteurs</a>
    <a href="/poulains">Poulains</a>
    <a href="/mariage">Mariage pour 2027</a>
    <a href="/gite">Gîte</a>
    <a href="https://blagapro.com/categorie-produit/boutiques-entreprises/lfm-farm-43150/" target="_blank" rel="noopener noreferrer">Boutique</a>
  </nav>

  <a class="contact-button" href="/contact">NOUS CONTACTER</a>
</header>

<script>
  const header = document.querySelector(".site-header");
  const menuButton = document.querySelector(".menu-toggle") as HTMLButtonElement;
  const menuLinks = document.querySelectorAll(".main-navigation a");

  const closeMenu = () => {
    header?.classList.remove("menu-open");
    menuButton?.setAttribute("aria-expanded", "false");
    menuButton?.setAttribute("aria-label", "Ouvrir le menu");
  };

  menuButton?.addEventListener("click", () => {
    const isOpen = header?.classList.toggle("menu-open") ?? false;
    menuButton.setAttribute("aria-expanded", String(isOpen));
    menuButton.setAttribute("aria-label", isOpen ? "Fermer le menu" : "Ouvrir le menu");
  });

  menuLinks.forEach((link) => link.addEventListener("click", closeMenu));

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });
</script>
