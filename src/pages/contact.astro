---
import Navbar from "../components/navbar.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";
import "../styles/contact.css";
const titre = "LFM Farm / Contact";
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Contactez LFM Farm à Salettes pour découvrir l’élevage, les chevaux disponibles et le gîte équestre." />
    <title>{titre}</title>
  </head>
  <body>
    <Navbar />
<main>
  <section class="contact-section">
    <img
      class="contact-background"
      src="https://res.cloudinary.com/dhmehfgjo/image/upload/v1787667995/background_contact_horses.jpg"
      alt=""
    />

    <div class="contact-overlay"></div>

    <div class="contact-container">
      <div class="contact-top">
        <!-- Coordonnées -->

        <article class="contact-card">
          <h1>LFM FARM</h1>
          <p class="contact-subtitle">Élevage de Paint Horse</p>

          <address class="contact-details">
            <a
              href="https://maps.google.com/?q=Lieu+dit+Maiguezin+43150+Salettes"
              target="_blank"
              rel="noopener noreferrer"
            >
              <img src="/icons/lucide--map-pin.svg" alt="" />
              <span>
                Lieu dit Maiguezin,<br />
                43150 Salettes
              </span>
            </a>

            <div class="contact-detail">
              <img src="/icons/lucide--phone.svg" alt="" />

              <span>
                <a href="tel:+33628331162">06.28.33.11.62</a>
                /
                <a href="tel:+33634961727">06.34.96.17.27</a>
              </span>
            </div>

            <a href="mailto:contact@lfmfarm.fr">
              <img src="/icons/lucide--mail.svg" alt="" />
              <span>contact@lfmfarm.fr</span>
            </a>
          </address>

          <div class="contact-socials">
            <a
              href="https://www.instagram.com/lfm_farm/?utm_source=ig_web_button_share_sheet"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram de LFM Farm"
            >
              <img src="/icons/lets-icons--insta.svg" alt="" />
            </a>

            <a
              href="https://www.facebook.com/media/set/?set=a.1476159574300721&amp;type=3"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook de LFM Farm"
            >
              <img src="/icons/akar-icons--facebook-fill.svg" alt="" />
            </a>
          </div>
        </article>

        <!-- Formulaire Web3Forms -->

<form class="contact-form" id="form"
        action="https://api.web3forms.com/submit"
          method="POST"
        >
          <input
            type="hidden"
            name="access_key"
            value="f2734df2-dc1b-47a4-b24b-e113c9c64d9a"
          />

          <input
            type="hidden"
            name="subject"
            value="Nouveau message depuis le site LFM Farm"
          />

          <input
            type="hidden"
            name="from_name"
            value="Site LFM Farm"
          />

          <!-- Protection antispam -->
          <input
            class="botcheck"
            type="checkbox"
            name="botcheck"
            tabindex="-1"
            autocomplete="off"
          />

          <div class="form-field">
            <label for="firstname">Prénom</label>
            <input
              id="firstname"
              type="text"
              name="Prénom"
              autocomplete="given-name"
              required
            />
          </div>

          <div class="form-field">
            <label for="lastname">Nom</label>
            <input
              id="lastname"
              type="text"
              name="Nom"
              autocomplete="family-name"
              required
            />
          </div>

          <div class="form-field">
            <label for="email">Adresse e-mail</label>
            <input
              id="email"
              type="email"
              name="email"
              autocomplete="email"
              required
            />
          </div>

          <div class="form-field">
            <label for="message">Message</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
            ></textarea>
          </div>
<div class="form-consent">
  <input
    id="privacy-consent"
    type="checkbox"
    name="Consentement à la politique de confidentialité"
    value="Accepté"
    required
  />

  <label for="privacy-consent">
    J’accepte que mes informations soient utilisées pour répondre à ma
    demande, conformément à la
    <a href="/politique-de-confidentialite" target="_blank">
        politique de confidentialité
    </a>.
  </label>
</div>

<div id="result" class="form-result" aria-live="polite"></div>
          <button type="submit">ENVOYER</button>
        </form>
      </div>

      <!-- Carte Google Maps -->

      <div class="contact-map">
        <div class="cookie-placeholder" data-cookie-placeholder="externalMedia">
          <strong>La carte Google Maps est désactivée</strong>
          <span>Acceptez les contenus externes pour afficher la carte.</span>
          <button type="button" class="js-cookie-settings">Gérer mes cookies</button>
        </div>

        <iframe
          data-cookie-src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d11310.22650370473!2d3.961843270538551!3d44.87132019409694!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12b4b3ebf5be305d%3A0xa093cb26a551010!2sMaiguezin%2C%2043150%20Salettes!5e0!3m2!1sfr!2sfr!4v1786738033628!5m2!1sfr!2sfr"
          title="Carte de LFM Farm"
          width="600"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    </div>
  </section>
</main>

    <footer>
      <Footer />
    </footer>
    <script>
  const form = document.getElementById("form") as HTMLFormElement;
  const result = document.getElementById("result") as HTMLElement;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    result.innerHTML = "Envoi en cours…";

    const response = await fetch("https://api.web3forms.com/submit", {
      method: "POST",
      body: new FormData(form),
    });

    const data = await response.json();
    if (data.success) {
      result.innerHTML = "Votre message a bien été envoyé.";
      form.reset();
    } else {
      result.innerHTML =
        "Une erreur est survenue. Vous pouvez nous écrire directement à contact@lfmfarm.fr.";
    }
  });
</script>

  </body>
</html>
