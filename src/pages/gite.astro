---
import Navbar from "../components/navbar.astro";
import Footer from "../components/footer.astro";
import "../styles/global.css";
import "../styles/gite.css";

const titre = "Gîte équestre et locations de vacances | LFM Farm";

const images = {
  facade:
    "https://res.cloudinary.com/dhmehfgjo/image/upload/v1786696058/gite_face.jpg",
  prairie:
    "https://res.cloudinary.com/dhmehfgjo/image/upload/v1786704058/chevaux_prairie.jpg",
  mezenc:
    "https://res.cloudinary.com/dhmehfgjo/image/upload/v1786737208/volcans-auvergne-haute-loire-mezenc-2-1920x1080-f50_50_pkwcfl.jpg",
};

const photosInterieur = [
  "https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666676/cache_14598929_tklunj.jpg",
  "https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666668/cache_14598926_dqhegd.jpg",
  "https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666664/cache_14598925_tgscdb.png",
  "https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666652/cache_13717987_tekbfk.jpg",
  "https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666648/cache_13717986_rmszwr.jpg",
  "https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666639/cache_13717982_wqaozy.jpg",
  "https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666635/cache_13717981_qv8xa3.png",
  "https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666631/cache_13717980_vou29v.jpg",
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Découvrez le gîte équestre LFM Farm en Haute-Loire, au cœur de la campagne et à proximité du Mézenc."
    />
    <title>{titre}</title>
  </head>

  <body>
    <Navbar />

    <main>
      <section class="gite-hero">
        <img
          class="gite-hero-image"
          src={images.facade}
          alt="La maison du gîte LFM Farm"
        />
        <div class="gite-hero-overlay"></div>

        <div class="gite-labels" aria-label="Labels touristiques">
          <img
            class="gite-label-image"
            src="https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666684/h%C3%A9bergement_respirando.jpg"
            alt="Label Hébergement Respirando"
          />
          <img
            class="gite-label-image"
            src="https://res.cloudinary.com/dhmehfgjo/image/upload/v1787666680/cheval_etape.jpg"
            alt="Label Cheval Étape"
          />
        </div>

        <div class="gite-hero-title">
          <h1>Gîte équestre et<br />locations de vacances</h1>
        </div>

        <div class="gite-hero-text">
          <p>
            Situé dans un charmant village de campagne,<br />
            entre rivières et montagnes surplombant la vallée de la Loire.
          </p>
          <p>
            Entouré de nos chevaux et sans aucun vis-à-vis,<br />
            le gîte est installé dans l’ancienne école du village, entièrement
            rénovée pour vous offrir tout le confort nécessaire à un séjour
            reposant et authentique.
          </p>
        </div>
      </section>

      <section class="gite-features">
        <div class="gite-features-grid">
          <article class="gite-feature gite-feature--intro">
            <div class="gite-icon" aria-hidden="true">
              <img src="/icons/ci--house-01.svg" alt="" />
            </div>
            <h2>Un hébergement chaleureux et tout confort</h2>
            <p>
              Le gîte a une capacité de 10 personnes, avec deux chambres de 4
              et un canapé-lit, deux WC ainsi que 2 salles de bain, une cuisine
              ouverte toute équipée et un coin salon.
            </p>
            <p>
              Pour rendre votre séjour aussi agréable que possible, vous
              bénéficiez également de nombreux équipements : lave-linge,
              lave-vaisselle, four, micro-ondes, bouilloire, appareil à raclette,
              appareil à fondue et crêpière.
            </p>
          </article>

          <div
            class="gite-interior-carousel"
            role="region"
            aria-label="Photos de l’intérieur du gîte"
            aria-roledescription="carrousel"
          >
            <div class="gite-interior-slides">
              {
                photosInterieur.map((photo, index) => (
                  <img
                    class:list={[
                      "gite-interior-slide",
                      { "is-active": index === 0 },
                    ]}
                    src={photo}
                    alt={`Intérieur du gîte LFM Farm - photo ${index + 1}`}
                    loading={index === 0 ? "eager" : "lazy"}
                    aria-hidden={index === 0 ? "false" : "true"}
                  />
                ))
              }
            </div>

            <button
              class="gite-carousel-expand"
              type="button"
              aria-label="Agrandir la photo"
            ></button>

            <button
              class="gite-carousel-arrow gite-carousel-arrow--previous"
              type="button"
              aria-label="Afficher la photo précédente"
            >
              <span aria-hidden="true"></span>
            </button>

            <button
              class="gite-carousel-arrow gite-carousel-arrow--next"
              type="button"
              aria-label="Afficher la photo suivante"
            >
              <span aria-hidden="true"></span>
            </button>

            <div class="gite-carousel-dots" aria-label="Choisir une photo">
              {
                photosInterieur.map((_, index) => (
                  <button
                    class:list={[
                      "gite-carousel-dot",
                      { "is-active": index === 0 },
                    ]}
                    type="button"
                    aria-label={`Afficher la photo ${index + 1}`}
                    aria-current={index === 0 ? "true" : "false"}
                    data-slide={index}
                  ></button>
                ))
              }
            </div>
          </div>

          <dialog class="gite-lightbox" aria-label="Photo agrandie de l’intérieur du gîte">
            <div class="gite-lightbox-content">
              <img
                class="gite-lightbox-image"
                src={photosInterieur[0]}
                alt="Intérieur du gîte LFM Farm"
              />

              <button
                class="gite-lightbox-close"
                type="button"
                aria-label="Fermer la photo agrandie"
              >
                <span aria-hidden="true">×</span>
              </button>

              <button
                class="gite-carousel-arrow gite-lightbox-arrow gite-lightbox-arrow--previous"
                type="button"
                aria-label="Afficher la photo précédente"
              >
                <span aria-hidden="true"></span>
              </button>

              <button
                class="gite-carousel-arrow gite-lightbox-arrow gite-lightbox-arrow--next"
                type="button"
                aria-label="Afficher la photo suivante"
              >
                <span aria-hidden="true"></span>
              </button>
            </div>
          </dialog>

          <img
            class="gite-feature-image"
            src={images.prairie}
            alt="Les chevaux dans les prés autour du gîte"
            loading="lazy"
          />

          <div class="gite-feature-stack">
            <article class="gite-feature">
              <div class="gite-icon" aria-hidden="true">
                <img src="/icons/lucide--calendar-days.svg" alt="" />
              </div>
              <h2>Un accueil toute l’année</h2>
              <p>
                Nous vous accueillons toute l’année, à la nuitée, en week-end ou
                pour plusieurs jours ou semaines, que vous soyez cavaliers,
                marcheurs, motards, vététistes ou simplement vacanciers.
              </p>
            </article>

            <article class="gite-feature">
              <div class="gite-icon gite-icon--horse" aria-hidden="true">
                <img src="/icons/hugeicons--horse-head.svg" alt="" />
              </div>
              <h2>Un accueil dédié<br />aux cavaliers</h2>
              <p>
                Pour les cavaliers, foin, granulés, paddocks, douche, boxes et
                sellerie sur place, maréchal-ferrant et dentiste équin sur place
                si besoin !
              </p>
            </article>
          </div>

          <img
            class="gite-feature-image"
            src={images.mezenc}
            alt="Le massif du Mézenc près du gîte"
            loading="lazy"
          />

          <div class="gite-feature-stack gite-feature-stack--location">
            <article class="gite-feature gite-feature--location">
              <div class="gite-icon" aria-hidden="true">
                <img src="/icons/lucide--mountain-snow.svg" alt="" />
              </div>
              <h2>Une situation idéale</h2>
              <p>
                Nous sommes situés à 1100 m d’altitude, à 30 min de la station de
                ski du Mézenc.
              </p>
            </article>

            <aside class="gite-restaurant">
              <div class="gite-restaurant-icon" aria-hidden="true">
                <img src="/icons/lucide--utensils.svg" alt="" />
              </div>
              <p>
                Un bar restaurant / pizzeria ouvert à l’année se trouve à 5 min en
                voiture, proposant aussi des plats à emporter ou livrés au gîte.
              </p>
            </aside>
          </div>
        </div>
      </section>

      <section class="gite-discovery">
        <h2>Une région riche en découvertes</h2>

        <div class="gite-discovery-top">
          <div class="gite-discovery-copy">
            <article class="gite-discovery-item">
              <div class="gite-icon" aria-hidden="true">
                <img src="/icons/lucide--tent.svg" alt="" />
              </div>
              <div>
                <h3>Randonnées et grands itinéraires</h3>
                <p>
                  De nombreux chemins de randonnée sillonnent les environs,
                  notamment le GR3F, le GR40 et le chemin de Stevenson (GR70).
                  Le Puy-en-Velay est également le point de départ de la Via
                  Podiensis vers Saint-Jacques-de-Compostelle.
                </p>
              </div>
            </article>

            <article class="gite-discovery-item">
              <div class="gite-icon" aria-hidden="true">
                <img src="/icons/lucide--camera.svg" alt="" />
              </div>
              <div>
                <h3>Villages et sites à découvrir</h3>
                <p>
                  De nombreux coins à visiter comme le Lac Bleu, ainsi que des
                  villages touristiques : le Lac d’Issarlès, Goudet, Coucouron ainsi
                  que la ville du Puy-en-Velay située à 30 min.
                </p>
              </div>
            </article>
          </div>

          <figure class="gite-discovery-photo gite-discovery-main">
            <img
              src="/images/region/randonnee-gr70-goudet.jpg"
              alt="Randonneurs accompagnés d’un âne sur le GR70 à Goudet"
              loading="lazy"
              width="1067"
              height="1600"
            />
            <figcaption>Sur le chemin de Stevenson à Goudet</figcaption>
          </figure>
        </div>

        <div class="gite-gallery">
          <figure class="gite-discovery-photo">
            <img
              src="/images/region/lac-issarles.jpg"
              alt="Le lac d’Issarlès entouré de collines boisées"
              loading="lazy"
              width="1600"
              height="1064"
            />
            <figcaption>Le lac d’Issarlès</figcaption>
          </figure>

          <figure class="gite-discovery-photo">
            <img
              src="/images/region/puy-en-velay.jpg"
              alt="Vue sur la cathédrale et les toits du Puy-en-Velay"
              loading="lazy"
              width="1600"
              height="1200"
            />
            <figcaption>Le Puy-en-Velay</figcaption>
          </figure>

          <figure class="gite-discovery-photo">
            <img
              src="/images/region/goudet-chateau-beaufort.jpg"
              alt="Goudet, la Loire et le château de Beaufort"
              loading="lazy"
              width="1600"
              height="1200"
            />
            <figcaption>Goudet et le château de Beaufort</figcaption>
          </figure>
        </div>

        <p class="gite-photo-credits">
          Crédits photos :
          <a href="https://commons.wikimedia.org/wiki/File:Hikers_and_donkey_on_GR_70_in_Goudet.jpg">MartinD</a>,
          <a href="https://commons.wikimedia.org/wiki/File:Lac_issarles_008.jpg">Michael.joffre</a>
          (<a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>) ;
          <a href="https://commons.wikimedia.org/wiki/File:Le_Puy-en-Velay_Vue_g%C3%A9n%C3%A9rale2.JPG">Torsade de Pointes</a>
          (domaine public) ;
          <a href="https://commons.wikimedia.org/wiki/File:Goudet,_la_Loire_et_le_ch%C3%A2teau_de_Beaufort.JPG">Havang(nl)</a>
          (CC0).
        </p>
      </section>

      <section class="gite-booking">
        <div class="gite-booking-container">
          <header class="gite-booking-heading">
            <p class="gite-booking-kicker">Préparer votre séjour</p>
            <h2>Consultez les disponibilités du gîte</h2>
            <p>
              Choisissez vos dates puis envoyez votre demande. Elle ne devient
              définitive qu’après confirmation de LFM Farm et réception de
              l’acompte.
            </p>
          </header>

          <div class="reservation-calendar" data-reservation-calendar>
            <div class="reservation-calendar-toolbar">
              <button type="button" class="reservation-calendar-nav reservation-calendar-nav--previous" data-calendar-previous aria-label="Afficher les mois précédents"><span aria-hidden="true"></span></button>
              <p data-calendar-title aria-live="polite">Chargement des disponibilités…</p>
              <button type="button" class="reservation-calendar-nav reservation-calendar-nav--next" data-calendar-next aria-label="Afficher les mois suivants"><span aria-hidden="true"></span></button>
            </div>

            <div class="reservation-months" data-calendar-months aria-label="Calendrier des disponibilités"></div>

            <div class="reservation-calendar-legend" aria-label="Légende du calendrier">
              <span><i class="is-available"></i>Disponible</span>
              <span><i class="is-requested"></i>Demande en cours</span>
              <span><i class="is-unavailable"></i>Indisponible</span>
            </div>

            <p class="reservation-calendar-status" data-calendar-status aria-live="polite"></p>
          </div>

          <form class="reservation-form" data-reservation-form>
            <div class="reservation-form-heading">
              <h3>Demander ces dates</h3>
              <p>Votre demande sera étudiée personnellement par LFM Farm.</p>
            </div>

            <input class="botcheck" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

            <div class="reservation-form-grid">
              <label>
                <span>Date d’arrivée *</span>
                <input type="date" name="dateArrivee" required data-arrival />
              </label>
              <label>
                <span>Date de départ *</span>
                <input type="date" name="dateDepart" required data-departure />
              </label>
              <label>
                <span>Prénom *</span>
                <input type="text" name="prenom" autocomplete="given-name" maxlength="80" required />
              </label>
              <label>
                <span>Nom *</span>
                <input type="text" name="nomClient" autocomplete="family-name" maxlength="80" required />
              </label>
              <label>
                <span>Adresse e-mail *</span>
                <input type="email" name="email" autocomplete="email" maxlength="160" required />
              </label>
              <label>
                <span>Téléphone</span>
                <input type="tel" name="telephone" autocomplete="tel" maxlength="30" />
              </label>
              <label>
                <span>Nombre d’adultes *</span>
                <input type="number" name="nombreAdultes" min="1" max="10" value="1" required />
              </label>
              <label>
                <span>Nombre d’enfants</span>
                <input type="number" name="nombreEnfants" min="0" max="10" value="0" />
              </label>
              <label>
                <span>Nombre de chevaux</span>
                <input type="number" name="nombreChevaux" min="0" max="10" value="0" />
              </label>
              <label class="reservation-form-message">
                <span>Votre message</span>
                <textarea name="message" rows="5" maxlength="2000" placeholder="Précisez vos besoins ou posez-nous vos questions."></textarea>
              </label>
            </div>

            <label class="reservation-form-consent">
              <input type="checkbox" name="consentement" required />
              <span>
                J’accepte que mes informations soient utilisées pour traiter ma
                demande conformément à la <a href="/politique-de-confidentialite" target="_blank">politique de confidentialité</a>.
              </span>
            </label>

            <p class="reservation-form-notice">
              L’envoi de ce formulaire ne confirme pas la réservation. Les dates
              seront bloquées après acceptation de la demande, puis confirmées à
              la réception de l’acompte.
            </p>

            <button class="gite-booking-button" type="submit">Envoyer ma demande</button>
            <p class="reservation-form-result" data-reservation-result aria-live="polite"></p>
          </form>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      const carousel = document.querySelector<HTMLElement>(".gite-interior-carousel");
      const slides = Array.from(
        document.querySelectorAll<HTMLImageElement>(".gite-interior-slide")
      );
      const dots = Array.from(
        document.querySelectorAll<HTMLButtonElement>(".gite-carousel-dot")
      );
      const previousButton = document.querySelector<HTMLButtonElement>(
        ".gite-carousel-arrow--previous"
      );
      const nextButton = document.querySelector<HTMLButtonElement>(
        ".gite-carousel-arrow--next"
      );
      const expandButton = document.querySelector<HTMLButtonElement>(
        ".gite-carousel-expand"
      );
      const lightbox = document.querySelector<HTMLDialogElement>(".gite-lightbox");
      const lightboxImage = document.querySelector<HTMLImageElement>(".gite-lightbox-image");
      const lightboxClose = document.querySelector<HTMLButtonElement>(".gite-lightbox-close");
      const lightboxPrevious = document.querySelector<HTMLButtonElement>(
        ".gite-lightbox-arrow--previous"
      );
      const lightboxNext = document.querySelector<HTMLButtonElement>(
        ".gite-lightbox-arrow--next"
      );

      let currentSlide = 0;
      let autoplay: number | undefined;
      let touchStartX = 0;

      const showSlide = (newIndex: number) => {
        if (slides.length === 0) return;

        currentSlide = (newIndex + slides.length) % slides.length;

        slides.forEach((slide, index) => {
          const isActive = index === currentSlide;
          slide.classList.toggle("is-active", isActive);
          slide.setAttribute("aria-hidden", String(!isActive));
        });

        dots.forEach((dot, index) => {
          const isActive = index === currentSlide;
          dot.classList.toggle("is-active", isActive);
          dot.setAttribute("aria-current", String(isActive));
        });

        if (lightbox?.open && lightboxImage) {
          lightboxImage.src = slides[currentSlide].src;
          lightboxImage.alt = slides[currentSlide].alt;
        }
      };

      const stopAutoplay = () => {
        if (autoplay) window.clearInterval(autoplay);
        autoplay = undefined;
      };

      const startAutoplay = () => {
        stopAutoplay();
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        autoplay = window.setInterval(() => showSlide(currentSlide + 1), 4500);
      };

      previousButton?.addEventListener("click", () => {
        showSlide(currentSlide - 1);
        startAutoplay();
      });

      nextButton?.addEventListener("click", () => {
        showSlide(currentSlide + 1);
        startAutoplay();
      });

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          showSlide(Number(dot.dataset.slide));
          startAutoplay();
        });
      });

      expandButton?.addEventListener("click", () => {
        if (!lightbox || !lightboxImage || slides.length === 0) return;
        stopAutoplay();
        lightboxImage.src = slides[currentSlide].src;
        lightboxImage.alt = slides[currentSlide].alt;
        lightbox.showModal();
      });

      lightboxClose?.addEventListener("click", () => lightbox?.close());
      lightboxPrevious?.addEventListener("click", () => showSlide(currentSlide - 1));
      lightboxNext?.addEventListener("click", () => showSlide(currentSlide + 1));

      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) lightbox.close();
      });

      lightbox?.addEventListener("close", startAutoplay);

      document.addEventListener("keydown", (event) => {
        if (!lightbox?.open) return;
        if (event.key === "ArrowLeft") showSlide(currentSlide - 1);
        if (event.key === "ArrowRight") showSlide(currentSlide + 1);
      });

      carousel?.addEventListener("mouseenter", stopAutoplay);
      carousel?.addEventListener("mouseleave", startAutoplay);
      carousel?.addEventListener("focusin", stopAutoplay);
      carousel?.addEventListener("focusout", startAutoplay);
      carousel?.addEventListener("touchstart", (event) => {
        touchStartX = event.touches[0]?.clientX || 0;
        stopAutoplay();
      }, { passive: true });
      carousel?.addEventListener("touchend", (event) => {
        const touchEndX = event.changedTouches[0]?.clientX || 0;
        const distance = touchEndX - touchStartX;
        if (Math.abs(distance) > 45) {
          showSlide(currentSlide + (distance < 0 ? 1 : -1));
        }
        startAutoplay();
      }, { passive: true });

      document.addEventListener("visibilitychange", () => {
        document.hidden ? stopAutoplay() : startAutoplay();
      });

      startAutoplay();

      /* Calendrier et demande de réservation du gîte */
      const bookingRoot = document.querySelector<HTMLElement>("[data-reservation-calendar]");
      const monthsRoot = document.querySelector<HTMLElement>("[data-calendar-months]");
      const calendarTitle = document.querySelector<HTMLElement>("[data-calendar-title]");
      const calendarStatus = document.querySelector<HTMLElement>("[data-calendar-status]");
      const previousMonths = document.querySelector<HTMLButtonElement>("[data-calendar-previous]");
      const nextMonths = document.querySelector<HTMLButtonElement>("[data-calendar-next]");
      const reservationForm = document.querySelector<HTMLFormElement>("[data-reservation-form]");
      const reservationResult = document.querySelector<HTMLElement>("[data-reservation-result]");
      const arrivalInput = document.querySelector<HTMLInputElement>("[data-arrival]");
      const departureInput = document.querySelector<HTMLInputElement>("[data-departure]");

      type ReservationPeriod = {
        start: string;
        end: string;
        status: "demandeRecue" | "attenteAcompte" | "confirmee" | "indisponible";
      };

      const monthNames = [
        "janvier", "février", "mars", "avril", "mai", "juin",
        "juillet", "août", "septembre", "octobre", "novembre", "décembre",
      ];
      const dayNames = ["L", "M", "M", "J", "V", "S", "D"];
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      let visibleMonth = new Date(today.getFullYear(), today.getMonth(), 1);
      let reservationPeriods: ReservationPeriod[] = [];
      const mobileCalendarQuery = window.matchMedia("(max-width: 760px)");

      const toDateKey = (date: Date) => {
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const day = String(date.getDate()).padStart(2, "0");
        return `${year}-${month}-${day}`;
      };

      const dateFromKey = (value: string) => {
        const [year, month, day] = value.split("-").map(Number);
        return new Date(year, month - 1, day);
      };

      const statusForDate = (dateKey: string) => {
        const matching = reservationPeriods.filter(
          (period) => dateKey >= period.start && dateKey < period.end
        );
        if (matching.some((period) => ["attenteAcompte", "confirmee", "indisponible"].includes(period.status))) return "unavailable";
        if (matching.some((period) => period.status === "demandeRecue")) return "requested";
        return "available";
      };

      const renderCalendar = () => {
        if (!monthsRoot || !calendarTitle) return;
        monthsRoot.innerHTML = "";

        const lastVisibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() + 1, 1);
        calendarTitle.textContent = mobileCalendarQuery.matches
          ? `${monthNames[visibleMonth.getMonth()]} ${visibleMonth.getFullYear()}`
          : `${monthNames[visibleMonth.getMonth()]} ${visibleMonth.getFullYear()} — ${monthNames[lastVisibleMonth.getMonth()]} ${lastVisibleMonth.getFullYear()}`;

        [visibleMonth, lastVisibleMonth].forEach((monthDate) => {
          const month = document.createElement("section");
          month.className = "reservation-month";
          const heading = document.createElement("h3");
          heading.textContent = `${monthNames[monthDate.getMonth()]} ${monthDate.getFullYear()}`;
          month.append(heading);

          const weekdays = document.createElement("div");
          weekdays.className = "reservation-weekdays";
          dayNames.forEach((day) => {
            const label = document.createElement("span");
            label.textContent = day;
            weekdays.append(label);
          });
          month.append(weekdays);

          const days = document.createElement("div");
          days.className = "reservation-days";
          const firstDay = new Date(monthDate.getFullYear(), monthDate.getMonth(), 1);
          const offset = (firstDay.getDay() + 6) % 7;
          const numberOfDays = new Date(monthDate.getFullYear(), monthDate.getMonth() + 1, 0).getDate();

          for (let index = 0; index < offset; index += 1) {
            const empty = document.createElement("span");
            empty.className = "reservation-day is-empty";
            days.append(empty);
          }

          for (let dayNumber = 1; dayNumber <= numberOfDays; dayNumber += 1) {
            const date = new Date(monthDate.getFullYear(), monthDate.getMonth(), dayNumber);
            const dateKey = toDateKey(date);
            const status = statusForDate(dateKey);
            const button = document.createElement("button");
            button.type = "button";
            button.className = `reservation-day is-${status}`;
            button.textContent = String(dayNumber);
            button.dataset.date = dateKey;
            button.setAttribute("aria-label", `${dayNumber} ${monthNames[monthDate.getMonth()]} ${monthDate.getFullYear()} — ${status === "available" ? "disponible" : "indisponibilité possible"}`);

            if (date < today || ["held", "unavailable"].includes(status)) {
              button.disabled = true;
            }

            const arrival = arrivalInput?.value;
            const departure = departureInput?.value;
            if (dateKey === arrival) button.classList.add("is-selection-start");
            if (dateKey === departure) button.classList.add("is-selection-end");
            if (arrival && departure && dateKey > arrival && dateKey < departure) {
              button.classList.add("is-selection-range");
            }

            button.addEventListener("click", () => {
              if (!arrivalInput || !departureInput) return;
              if (!arrivalInput.value || departureInput.value) {
                arrivalInput.value = dateKey;
                departureInput.value = "";
              } else if (dateKey > arrivalInput.value) {
                departureInput.value = dateKey;
              } else {
                arrivalInput.value = dateKey;
                departureInput.value = "";
              }
              renderCalendar();
            });
            days.append(button);
          }
          month.append(days);
          monthsRoot.append(month);
        });
      };

      const loadAvailability = async () => {
        if (!calendarStatus) return;
        calendarStatus.textContent = "Chargement des disponibilités…";
        try {
          const response = await fetch("/api/reservations-gite", { headers: { Accept: "application/json" } });
          if (!response.ok) throw new Error("Calendrier indisponible");
          const data = await response.json();
          reservationPeriods = Array.isArray(data.periods) ? data.periods : [];
          calendarStatus.textContent = "Calendrier mis à jour.";
        } catch {
          calendarStatus.textContent = "Les disponibilités ne peuvent pas être chargées actuellement. Vous pouvez tout de même envoyer une demande.";
        }
        renderCalendar();
      };

      const minimumDate = toDateKey(today);
      if (arrivalInput) arrivalInput.min = minimumDate;
      if (departureInput) departureInput.min = minimumDate;
      arrivalInput?.addEventListener("change", () => {
        if (departureInput) {
          departureInput.min = arrivalInput.value || minimumDate;
          if (departureInput.value && departureInput.value <= arrivalInput.value) departureInput.value = "";
        }
        renderCalendar();
      });
      departureInput?.addEventListener("change", renderCalendar);

      previousMonths?.addEventListener("click", () => {
        const previous = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() - 1, 1);
        const currentMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        visibleMonth = previous < currentMonth ? currentMonth : previous;
        renderCalendar();
      });
      nextMonths?.addEventListener("click", () => {
        visibleMonth = new Date(visibleMonth.getFullYear(), visibleMonth.getMonth() + 1, 1);
        renderCalendar();
      });
      mobileCalendarQuery.addEventListener("change", renderCalendar);

      reservationForm?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!reservationResult) return;
        reservationResult.className = "reservation-form-result";
        reservationResult.textContent = "Envoi de votre demande…";
        const submitButton = reservationForm.querySelector<HTMLButtonElement>("button[type='submit']");
        if (submitButton) submitButton.disabled = true;

        try {
          const formData = new FormData(reservationForm);
          const payload = Object.fromEntries(formData.entries());
          const response = await fetch("/api/reservations-gite", {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify(payload),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.message || "La demande n’a pas pu être envoyée.");

          reservationResult.classList.add("is-success");
          reservationResult.textContent = "Votre demande a bien été enregistrée. LFM Farm vous contactera après vérification des dates.";
          reservationForm.reset();
          if (arrivalInput) arrivalInput.min = minimumDate;
          if (departureInput) departureInput.min = minimumDate;
          await loadAvailability();
        } catch (error) {
          reservationResult.classList.add("is-error");
          reservationResult.textContent = error instanceof Error ? error.message : "Une erreur est survenue. Vous pouvez contacter LFM Farm directement.";
        } finally {
          if (submitButton) submitButton.disabled = false;
        }
      });

      if (bookingRoot) {
        renderCalendar();
        loadAvailability();
      }
    </script>
  </body>
</html>
