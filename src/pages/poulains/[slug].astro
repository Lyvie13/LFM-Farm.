---
import Navbar from "../../components/navbar.astro";
import Footer from "../../components/footer.astro";
import FicheCheval from "../../components/FicheCheval.astro";

import { contentfulClient } from "../../lib/contentful";

import "../../styles/global.css";
import "../../styles/fiche-cheval.css";

export async function getStaticPaths() {
  const response = await contentfulClient.getEntries({
    content_type: "poulains",
    include: 2,
  });

  return response.items
    .filter(
      (poulain: any) =>
        poulain.fields.slug
    )
    .map((poulain: any) => ({
      params: {
        slug: poulain.fields.slug,
      },

      props: {
        poulain,
      },
    }));
}

const { poulain } = Astro.props;
const fields = poulain.fields;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width"
    />

    <title>
      {fields.nom} | Poulain | LFM Farm
    </title>
  </head>

  <body>
    <Navbar />

    <FicheCheval
      cheval={poulain}
      typeCheval="Poulain"
      lienRetour="/poulains"
      texteRetour="Retour aux poulains"
    />

    <Footer />
  </body>
</html>