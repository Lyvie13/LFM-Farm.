---
const { mariage } = Astro.props;
const fields = mariage.fields;

/* Références Contentful */
const etalon =
  fields.etalon ||
  fields.etalons ||
  fields.talon;

const pouliniere =
  fields.pouliniere ||
  fields.poulinieres;

const etalonFields = etalon?.fields;
const pouliniereFields = pouliniere?.fields;

/* Fonction pour récupérer correctement une image Contentful */
const getImageUrl = (entry: any = null) => {
  const url = entry?.fields?.photoPrincipale?.fields?.file?.url;

  if (!url) return "";
  if (url.startsWith("//")) return `https:${url}`;

  return url;
};

/* Images */
const etalonImageUrl = getImageUrl(etalon);
const pouliniereImageUrl = getImageUrl(pouliniere);

const nombreImages = [
  etalonImageUrl,
  pouliniereImageUrl,
].filter(Boolean).length;

/* Noms */
const nomEtalon = etalonFields?.nom || "";
const nomPouliniere = pouliniereFields?.nom || "";
const slugEtalon = etalonFields?.slug || "";
const slugPouliniere = pouliniereFields?.slug || "";

/* Titre de la carte */
const titre =
  fields.titrePersonnalise ||
  [nomEtalon, nomPouliniere]
    .filter(Boolean)
    .join(" & ");

/* Informations génétiques */
const informationsGenetiques = [
  etalonFields?.genotype,
  pouliniereFields?.genotype,
]
  .filter(Boolean)
  .join(" × ");

/* Date du terme */
const dateTerme = fields.dateTerme
  ? new Date(fields.dateTerme).toLocaleDateString("fr-FR", {
      day: "numeric",
      month: "long",
      year: "numeric",
      timeZone: "UTC",
    })
  : "";

const dateTermeTri = fields.dateTerme
  ? new Date(fields.dateTerme).getTime()
  : Number.MAX_SAFE_INTEGER;

/* Bouton */
const afficherBouton =
  fields.reservationOuverte === true &&
  fields.lienBouton;
---

<article
  class="marriage-card"
  data-term-date={dateTermeTri}
  data-marriage-name={titre.toLocaleLowerCase("fr-FR")}
>

  <div
    class:list={[
      "marriage-card-images",
      {
        "marriage-card-images--single": nombreImages === 1,
      },
    ]}
  >
    {
      etalonImageUrl && (
        <div
          class="marriage-photo marriage-photo--stallion"
          style={`--marriage-photo: url("${etalonImageUrl}")`}
        >
          <img
            src={etalonImageUrl}
            alt={`Étalon ${nomEtalon}`}
            loading="lazy"
          />
        </div>
      )
    }

    {
      pouliniereImageUrl && (
        <div
          class="marriage-photo marriage-photo--mare"
          style={`--marriage-photo: url("${pouliniereImageUrl}")`}
        >
          <img
            src={pouliniereImageUrl}
            alt={`Poulinière ${nomPouliniere}`}
            loading="lazy"
          />
        </div>
      )
    }
  </div>

  <div class="marriage-card-content">

    {
      nomEtalon || nomPouliniere ? (
        <h2 class="marriage-title">
          {nomEtalon && (
            slugEtalon ? (
              <a href={`/etalons/${slugEtalon}`}>{nomEtalon}</a>
            ) : (
              <span>{nomEtalon}</span>
            )
          )}

          {nomEtalon && nomPouliniere && <span aria-hidden="true"> &amp; </span>}

          {nomPouliniere && (
            slugPouliniere ? (
              <a href={`/poulinieres/${slugPouliniere}`}>{nomPouliniere}</a>
            ) : (
              <span>{nomPouliniere}</span>
            )
          )}
        </h2>
      ) : (
        titre && <h2>{titre}</h2>
      )
    }

    {
      informationsGenetiques && (
        <p class="marriage-genetics">
          {informationsGenetiques}
        </p>
      )
    }

    {
      dateTerme && (
        <p class="marriage-term">
          TERME : {dateTerme}
        </p>
      )
    }

    {
      fields.informationsComplementaires && (
        <p class="marriage-description">
          {fields.informationsComplementaires}
        </p>
      )
    }

    {
      afficherBouton && (
        <a
          class="marriage-button"
          href={fields.lienBouton}
        >
          {fields.texteBouton || "RÉSERVER LA NAISSANCE"}
        </a>
      )
    }

    {
      fields.reservationOuverte === false &&
      fields.statut && (
        <p class="marriage-status">
          {fields.statut}
        </p>
      )
    }

  </div>
</article>

<style>
.marriage-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  width: 100%;
  border-radius: 8px;
  background-color: white;
  box-shadow: 0 4px 12px rgba(54, 24, 12, 0.15);
}

.marriage-card-images {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  width: 100%;
  height: 360px;
  flex-shrink: 0;
}
  .marriage-card-images--single {
    grid-template-columns: 1fr;
  }

  .marriage-photo {
    position: relative;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    background-color: #d8c9bb;
  }

  .marriage-photo::before {
    position: absolute;
    inset: -18px;
    background-image: var(--marriage-photo);
    background-position: center;
    background-size: cover;
    content: "";
    filter: blur(12px) brightness(0.78);
    transform: scale(1.06);
  }

  .marriage-photo img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

.marriage-card-content {
  position: static !important;
  display: block;
  width: 100%;
  min-height: 210px;
  padding: 35px 30px 40px;
  background-color: white;
  color: #28231f;
  text-align: center;
}
  .marriage-card-content h2 {
    margin: 0 0 18px;
    font-family: Baskerville, "Baskerville Old Face", Georgia, serif;
    font-size: clamp(23px, 2.4vw, 34px);
    font-weight: 400;
    text-transform: uppercase;
  }

  .marriage-title a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }

  .marriage-title a:hover,
  .marriage-title a:focus-visible {
    color: #a83f1d;
    text-decoration-color: currentColor;
  }

  .marriage-genetics {
    margin: 0 0 18px;
    font-family: Arial, sans-serif;
    font-size: 13px;
    /* Ne jamais modifier la casse d'un génotype. */
    text-transform: none;
  }

  .marriage-term {
    margin: 0 0 22px;
    color: #a83f1d;
    font-family: Arial, sans-serif;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .marriage-description {
    max-width: 650px;
    margin: 0 auto 25px;
    font-family: Arial, sans-serif;
    line-height: 1.5;
  }

  .marriage-button {
    display: inline-block;
    padding: 17px 35px;
    border-radius: 8px;
    background-color: #a83f1d;
    color: white;
    font-family: Arial, sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
  }

  .marriage-button:hover {
    background-color: #7f2c11;
  }

  .marriage-status {
    display: inline-block;
    margin: 0;
    padding: 10px 18px;
    border: 1px solid #a83f1d;
    border-radius: 8px;
    color: #a83f1d;
    font-weight: 700;
  }

  @media (max-width: 600px) {
    .marriage-card-images {
      height: auto;
      aspect-ratio: 1.55 / 1;
    }

    .marriage-card-content {
      min-height: 0;
      padding: 28px 20px 32px;
    }

    .marriage-card-content h2 {
      font-size: 23px;
    }

    .marriage-button {
      width: 100%;
      padding: 15px 18px;
    }
  }

</style>
