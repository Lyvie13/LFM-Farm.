---
const {
  cheval,
  typeCheval,
  lienRetour,
  texteRetour,
} = Astro.props;

const fields = cheval.fields;

/* =========================
   IMAGES CONTENTFUL
========================= */

const getImageUrl = (image: any) => {
  const url = image?.fields?.file?.url;

  if (!url) return "";

  if (url.startsWith("//")) {
    return `https:${url}`;
  }

  return url;
};

const photoPrincipale = getImageUrl(
  fields.photoPrincipale
);

const galerie =
  fields.galerie ||
  fields.photos ||
  fields.galeriePhotos ||
  [];

const photosGalerie = galerie
  .map((photo: any) => getImageUrl(photo))
  .filter(Boolean);

const toutesPhotos = [...new Set(
  [photoPrincipale, ...photosGalerie].filter(Boolean)
)];

/* =========================
   INFORMATIONS GÉNÉRALES
========================= */

const description =
  fields.descriptionCourte ||
  fields.description ||
  "";

const informations =
  fields.resultatsGenetiques ||
  fields.informations ||
  fields.informationsComplementaires ||
  "";

const lienFacebook =
  fields.lienFacebook ||
  fields.facebook ||
  "";

/* =========================
   PARENTS
========================= */

const getNomParent = (parent: any) => {
  if (!parent) return "";

  if (parent?.fields?.nom) {
    return parent.fields.nom;
  }

  if (typeof parent === "string") {
    return parent;
  }

  return "";
};

const getLienParent = (parent: any) => {
  const slug = parent?.fields?.slug;
  const contentType = parent?.sys?.contentType?.sys?.id;

  if (!slug || !contentType) return "";

  const chemins: Record<string, string> = {
    etalons: "etalons",
    poulinieres: "poulinieres",
    poulains: "poulains",
  };

  const chemin = chemins[contentType];
  return chemin ? `/${chemin}/${slug}` : "";
};

const pere = getNomParent(fields.pere);
const mere = getNomParent(fields.mere);
const lienPere = getLienParent(fields.pere);
const lienMere = getLienParent(fields.mere);

/* =========================
   DATE DE NAISSANCE
========================= */

const dateNaissance = fields.dateNaissance
  ? new Date(fields.dateNaissance).toLocaleDateString(
      "fr-FR",
      {
        day: "numeric",
        month: "long",
        year: "numeric",
      }
    )
  : "";

const sexe = fields.sexe || "";

const accorderStatut = (statut: string | undefined) => {
  if (!statut) return "";

  const estFemelle = sexe.trim().toLocaleLowerCase("fr").startsWith("f");
  const estReserve = /^r[eé]serv[eé]$/i.test(statut.trim());

  if (!estFemelle || !estReserve) return statut;
  if (statut === statut.toLocaleUpperCase("fr")) return "RÉSERVÉE";
  if (/^[A-ZÀ-ÖØ-Þ]/.test(statut)) return "Réservée";
  return "réservée";
};

const statutAffiche = accorderStatut(fields.statut);

const texteNaissance =
  sexe.toLowerCase().startsWith("f")
    ? "Née le"
    : "Né le";
---

<main>
  <div class="horse-back">
    <a href={lienRetour}>
      ← {texteRetour}
    </a>
  </div>

  <section class="horse-detail">

    <!-- =========================
         PHOTOS
    ========================== -->

    <div class="horse-gallery">
      <div class="horse-main-image-wrapper">
        {
          photoPrincipale ? (
            <>
              <img
                id="horse-main-image-background"
                class="horse-main-image-background"
                src={photoPrincipale}
                alt=""
                aria-hidden="true"
              />
              <img
                id="horse-main-image"
                class="horse-main-image"
                src={photoPrincipale}
                alt={`${typeCheval} ${fields.nom || ""}`}
              />
            </>
          ) : (
            <div class="horse-no-image">
              Aucune photo disponible
            </div>
          )
        }

        {
          toutesPhotos.length > 1 && (
            <>
              <button
                class="horse-gallery-arrow horse-gallery-arrow--previous"
                type="button"
                aria-label="Afficher la photo précédente"
              >
                <span aria-hidden="true">‹</span>
              </button>

              <button
                class="horse-gallery-arrow horse-gallery-arrow--next"
                type="button"
                aria-label="Afficher la photo suivante"
              >
                <span aria-hidden="true">›</span>
              </button>
            </>
          )
        }
      </div>

      {
        galerie.length > 0 && (
          <div class="horse-thumbnails">
            {photosGalerie.map((photoUrl: string) => {
              return (
                photoUrl && (
                  <button
                    class="horse-thumbnail-button"
                    type="button"
                    data-image={photoUrl}
                    aria-label={`Afficher une autre photo de ${fields.nom}`}
                  >
                    <img
                      src={photoUrl}
                      alt={`${fields.nom} à LFM Farm`}
                      loading="lazy"
                    />
                  </button>
                )
              );
            })}
          </div>
        )
      }
    </div>

    <!-- =========================
         INFORMATIONS
    ========================== -->

    <div class="horse-information">
      <p class="horse-type">
        {typeCheval}
      </p>

      <h1>{fields.nom}</h1>

      {
        (sexe || dateNaissance) && (
          <p class="horse-summary">
            {sexe}

            {sexe && dateNaissance && " – "}

            {
              dateNaissance &&
              `${texteNaissance} ${dateNaissance}`
            }
          </p>
        )
      }

      {
        description && (
          <p class="horse-description">
            {description}
          </p>
        )
      }

      {
        fields.robe && (
          <p class="horse-coat">
            <strong>Robe :</strong>{" "}
            {fields.robe}
          </p>
        )
      }

      <!-- PARENTS -->

      {
        (pere || mere) && (
          <div class="horse-parents">
            {
              pere && (
                <p>
                  <strong>Père :</strong>{" "}
                  {
                    lienPere ? (
                      <a href={lienPere}>{pere}</a>
                    ) : (
                      pere
                    )
                  }
                </p>
              )
            }

            {
              mere && (
                <p>
                  <strong>Mère :</strong>{" "}
                  {
                    lienMere ? (
                      <a href={lienMere}>{mere}</a>
                    ) : (
                      mere
                    )
                  }
                </p>
              )
            }
          </div>
        )
      }

      <!-- GÉNOTYPE -->

      {
        fields.genotype && (
          <div class="horse-extra">
            <h2>Génotype</h2>

            <p>{fields.genotype}</p>
          </div>
        )
      }

      <!-- INFORMATIONS COMPLÉMENTAIRES -->

      {
        informations && (
          <div class="horse-extra">
            <h2>Informations</h2>

            <p>{informations}</p>
          </div>
        )
      }

      <!-- STATUT DU POULAIN -->

      {
        statutAffiche && (
          <p class="horse-status">
            {statutAffiche}
          </p>
        )
      }

      <!-- PRIX -->

      {
        fields.prix && (
          <p class="horse-price">
            {fields.prix}
          </p>
        )
      }

      <!-- FACEBOOK -->

      {
        lienFacebook && (
          <a
            class="horse-facebook"
            href={lienFacebook}
            target="_blank"
            rel="noopener noreferrer"
          >
            Voir plus de photos ou suivre son évolution sur Facebook
          </a>
        )
      }

      <!-- BOUTON DE CONTACT -->

      {
        fields.reservable !== false && (
          <a
            class="horse-contact-button"
            href="/contact"
          >
            NOUS CONTACTER
          </a>
        )
      }
    </div>
  </section>
</main>

<!-- =========================
     CHANGEMENT DE PHOTO
========================== -->

<script>
  const imagePrincipale =
    document.querySelector<HTMLImageElement>(
      "#horse-main-image"
    );

  const arrierePlanImagePrincipale =
    document.querySelector<HTMLImageElement>(
      "#horse-main-image-background"
    );

  const miniatures =
    document.querySelectorAll<HTMLButtonElement>(
      ".horse-thumbnail-button"
    );

  const boutonPrecedent =
    document.querySelector<HTMLButtonElement>(
      ".horse-gallery-arrow--previous"
    );

  const boutonSuivant =
    document.querySelector<HTMLButtonElement>(
      ".horse-gallery-arrow--next"
    );

  const photos = imagePrincipale
    ? [
        imagePrincipale.src,
        ...Array.from(miniatures)
          .map((miniature) => miniature.dataset.image)
          .filter((url): url is string => Boolean(url)),
      ].filter((url, index, liste) => liste.indexOf(url) === index)
    : [];

  let indexPhoto = 0;

  const afficherPhoto = (nouvelIndex: number) => {
    if (!imagePrincipale || photos.length === 0) return;

    indexPhoto = (nouvelIndex + photos.length) % photos.length;
    imagePrincipale.src = photos[indexPhoto];
    if (arrierePlanImagePrincipale) {
      arrierePlanImagePrincipale.src = photos[indexPhoto];
    }

    miniatures.forEach((miniature) => {
      miniature.classList.toggle(
        "is-active",
        miniature.dataset.image === photos[indexPhoto]
      );
    });
  };

  miniatures.forEach((miniature) => {
    miniature.addEventListener("click", () => {
      const nouvelleImage =
        miniature.dataset.image;

      if (imagePrincipale && nouvelleImage) {
        const nouvelIndex = photos.indexOf(nouvelleImage);
        afficherPhoto(nouvelIndex >= 0 ? nouvelIndex : 0);
      }
    });
  });

  boutonPrecedent?.addEventListener("click", () => {
    afficherPhoto(indexPhoto - 1);
  });

  boutonSuivant?.addEventListener("click", () => {
    afficherPhoto(indexPhoto + 1);
  });
</script>
